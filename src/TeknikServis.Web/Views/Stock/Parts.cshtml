@{
    ViewData["Title"] = "Parça Stok";
    int page = ViewBag.Page ?? 1;
    int total = ViewBag.TotalCount ?? 0;
    int totalPages = ViewBag.TotalPages ?? 1;
    string? q = ViewBag.Q as string;
}

<div class="flex flex-col gap-5">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-xl font-semibold text-gray-900 dark:text-white">Parça Stok</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">Toplam <span class="font-medium text-gray-700 dark:text-gray-300">@total</span> kalem</p>
        </div>
        <div class="flex gap-2">
            <a href="@Url.Action("Devices","Stock")"
               class="px-4 py-2 border border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                Cihaz Envanteri
            </a>
            <a href="@Url.Action("WriteOffs","Stock")"
               class="px-4 py-2 border border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                Fire Kayıtları
            </a>
        </div>
    </div>

    {{!-- Search --}}
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4">
        <form method="get" class="flex gap-3">
            <div class="flex-1 relative">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0"/>
                </svg>
                <input type="text" name="q" value="@q" placeholder="Parça adı veya kod ara..."
                       class="w-full pl-9 pr-4 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
            </div>
            <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">Ara</button>
        </form>
    </div>

    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                <tr>
                    <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Parça</th>
                    <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Kod</th>
                    <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Stok</th>
                    <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Min.</th>
                    <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Ort. Maliyet</th>
                    <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Durum</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-gray-700" id="stockTableBody">
                <tr>
                    <td colspan="6" class="text-center py-10 text-gray-400 dark:text-gray-500 text-sm">Yükleniyor...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // Data is passed via model (server-side rendered)
        document.addEventListener('DOMContentLoaded', function() {
            const rows = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
            const tbody = document.getElementById('stockTableBody');
            if (!rows || !rows.length) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center py-10 text-gray-400 text-sm">Kayıt bulunamadı</td></tr>';
                return;
            }
            tbody.innerHTML = rows.map(r => `
                <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors ${r.isLow ? 'bg-amber-50/50 dark:bg-amber-900/5' : ''}">
                    <td class="px-5 py-3 font-medium text-gray-800 dark:text-gray-200">${r.partName}</td>
                    <td class="px-4 py-3 font-mono text-xs text-gray-500 dark:text-gray-400">${r.partCode}</td>
                    <td class="px-4 py-3 text-center font-medium ${r.isLow ? 'text-amber-600 dark:text-amber-400' : 'text-gray-800 dark:text-gray-200'}">${r.quantity}</td>
                    <td class="px-4 py-3 text-center text-gray-400 dark:text-gray-500">${r.reorderThreshold}</td>
                    <td class="px-4 py-3 text-right text-gray-700 dark:text-gray-300">${r.averageCost.toFixed(2)} ₺</td>
                    <td class="px-4 py-3 text-center">
                        ${r.isLow
                            ? '<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-400">Kritik</span>'
                            : '<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-400">Yeterli</span>'
                        }
                    </td>
                </tr>
            `).join('');
        });
    </script>
}
