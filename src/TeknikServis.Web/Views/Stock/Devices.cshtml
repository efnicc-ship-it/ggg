@model IEnumerable<TeknikServis.Domain.Entities.Device.DeviceInventory>
@using TeknikServis.Domain.Enums

@{
    int page = ViewBag.Page ?? 1;
    int total = ViewBag.TotalCount ?? 0;
    int totalPages = ViewBag.TotalPages ?? 1;
    string? q = ViewBag.Q as string;
}

<div class="flex flex-col gap-5">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-xl font-semibold text-gray-900 dark:text-white">Cihaz Envanteri</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">Toplam <span class="font-medium text-gray-700 dark:text-gray-300">@total</span> cihaz</p>
        </div>
        <div class="flex gap-2">
            <a href="@Url.Action("Parts","Stock")" class="px-4 py-2 border border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">Parça Stok</a>
            <a href="@Url.Action("WriteOffs","Stock")" class="px-4 py-2 border border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">Fire Kayıtları</a>
        </div>
    </div>

    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4">
        <form method="get" class="flex gap-3">
            <div class="flex-1 relative">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0"/>
                </svg>
                <input type="text" name="q" value="@q" placeholder="Marka, model veya IMEI ara..."
                       class="w-full pl-9 pr-4 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
            </div>
            <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">Ara</button>
        </form>
    </div>

    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
        @if (!Model.Any())
        {
            <div class="text-center py-16 text-gray-400 dark:text-gray-500 text-sm">Cihaz bulunamadı</div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                        <tr>
                            <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Cihaz</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">IMEI</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Özellikler</th>
                            <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Durum</th>
                            <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Alış</th>
                            <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Hedef</th>
                            <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">IMEI Kontrol</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Tarih</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                        @foreach (var device in Model)
                        {
                            var (sbg, stxt) = GetStatusBadge(device.Status);
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                                <td class="px-5 py-3">
                                    <div class="font-medium text-gray-800 dark:text-gray-200">
                                        @device.Catalog.Model.Brand.Name @device.Catalog.Model.Name
                                    </div>
                                    @if (!string.IsNullOrEmpty(device.Color))
                                    {
                                        <div class="text-xs text-gray-400">@device.Color</div>
                                    }
                                </td>
                                <td class="px-4 py-3 font-mono text-xs text-gray-600 dark:text-gray-400">@(device.Imei1 ?? "—")</td>
                                <td class="px-4 py-3 text-xs text-gray-500 dark:text-gray-400">
                                    @(device.Ram ?? "")@(device.Ram != null && device.Storage != null ? " / " : "")@(device.Storage ?? "")
                                    @if (device.BatteryHealth.HasValue)
                                    {
                                        <span class="ml-1 text-green-600 dark:text-green-400">%@device.BatteryHealth</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium @sbg @stxt">@GetStatusLabel(device.Status)</span>
                                </td>
                                <td class="px-4 py-3 text-right text-gray-700 dark:text-gray-300">@device.PurchasePrice.ToString("N2") ₺</td>
                                <td class="px-4 py-3 text-right text-gray-700 dark:text-gray-300">@device.TargetSalePrice.ToString("N2") ₺</td>
                                <td class="px-4 py-3 text-center">
                                    @if (device.ImeiChecked)
                                    {
                                        <svg class="w-4 h-4 text-green-500 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg class="w-4 h-4 text-amber-500 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                                        </svg>
                                    }
                                </td>
                                <td class="px-4 py-3 text-xs text-gray-400 dark:text-gray-500">@device.PurchasedAt.ToString("dd.MM.yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="flex justify-end gap-1 px-4 py-3 border-t border-gray-100 dark:border-gray-700">
                    @for (int p = Math.Max(1, page - 2); p <= Math.Min(totalPages, page + 2); p++)
                    {
                        <a href="@Url.Action("Devices","Stock", new{q, page=p})"
                           class="px-3 py-1.5 text-sm border rounded-lg @(p == page ? "bg-blue-600 border-blue-600 text-white" : "border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300")">@p</a>
                    }
                </div>
            }
        }
    </div>
</div>

@functions {
    static (string bg, string txt) GetStatusBadge(InventoryStatus s) => s switch
    {
        InventoryStatus.Available   => ("bg-green-100 dark:bg-green-900/40", "text-green-700 dark:text-green-400"),
        InventoryStatus.Reserved    => ("bg-blue-100 dark:bg-blue-900/40", "text-blue-700 dark:text-blue-400"),
        InventoryStatus.Sold        => ("bg-gray-100 dark:bg-gray-700", "text-gray-600 dark:text-gray-400"),
        InventoryStatus.UnderRepair => ("bg-purple-100 dark:bg-purple-900/40", "text-purple-700 dark:text-purple-400"),
        InventoryStatus.Scrapped    => ("bg-red-100 dark:bg-red-900/40", "text-red-700 dark:text-red-400"),
        _                           => ("bg-gray-100 dark:bg-gray-700", "text-gray-600 dark:text-gray-400")
    };

    static string GetStatusLabel(InventoryStatus s) => s switch
    {
        InventoryStatus.Available   => "Satılık",
        InventoryStatus.Reserved    => "Rezerve",
        InventoryStatus.Sold        => "Satıldı",
        InventoryStatus.UnderRepair => "Onarımda",
        InventoryStatus.Transferred => "Transfer",
        InventoryStatus.Scrapped    => "Hurda",
        _ => s.ToString()
    };
}
