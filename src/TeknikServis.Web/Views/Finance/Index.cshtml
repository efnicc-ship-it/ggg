@using TeknikServis.Domain.Entities.Finance
@{
    var accounts = ViewBag.Accounts as List<Account> ?? new List<Account>();
    int customerCount = ViewBag.CustomerReceivablesCount;
    decimal customerTotal = ViewBag.CustomerReceivablesTotal;
    int customerOverdue = ViewBag.CustomerReceivablesOverdue;
    int dealerCount = ViewBag.DealerReceivablesCount;
    decimal dealerTotal = ViewBag.DealerReceivablesTotal;
    int supplierCount = ViewBag.SupplierPayablesCount;
    decimal supplierTotal = ViewBag.SupplierPayablesTotal;
}

<div class="flex flex-col gap-5">

    <div>
        <h1 class="text-xl font-semibold text-gray-900 dark:text-white">Finans</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">Hesap bakiyeleri, alacak ve borç takibi</p>
    </div>

    @* Özet Kartlar *@
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <a href="@Url.Action("Receivables","Finance")"
           class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-5 hover:border-blue-300 dark:hover:border-blue-600 transition-colors">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Müşteri Alacakları</span>
                @if (customerOverdue > 0)
                {
                    <span class="text-xs font-medium text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20 px-2 py-0.5 rounded">@customerOverdue gecikmiş</span>
                }
            </div>
            <div class="text-2xl font-bold text-gray-900 dark:text-white">@customerTotal.ToString("N2") ₺</div>
            <div class="text-xs text-gray-400 mt-1">@customerCount açık kayıt</div>
        </a>

        <a href="@Url.Action("Receivables","Finance")"
           class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-5 hover:border-blue-300 dark:hover:border-blue-600 transition-colors">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Bayi Alacakları</span>
            </div>
            <div class="text-2xl font-bold text-gray-900 dark:text-white">@dealerTotal.ToString("N2") ₺</div>
            <div class="text-xs text-gray-400 mt-1">@dealerCount açık kayıt</div>
        </a>

        <a href="@Url.Action("Payables","Finance")"
           class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-5 hover:border-red-300 dark:hover:border-red-600 transition-colors">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Tedarikçi Borçları</span>
            </div>
            <div class="text-2xl font-bold text-red-600 dark:text-red-400">@supplierTotal.ToString("N2") ₺</div>
            <div class="text-xs text-gray-400 mt-1">@supplierCount açık kayıt</div>
        </a>
    </div>

    @* Hesap Bakiyeleri *@
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 dark:border-gray-700">
            <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300">Hesap Bakiyeleri</h2>
        </div>
        @if (!accounts.Any())
        {
            <div class="text-center py-12 text-gray-400 dark:text-gray-500 text-sm">Hesap tanımlanmamış</div>
        }
        else
        {
            <table class="w-full text-sm">
                <thead class="bg-gray-50 dark:bg-gray-700/50">
                    <tr>
                        <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Kod</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Hesap Adı</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Tür</th>
                        <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Bakiye</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                    @foreach (var account in accounts.OrderBy(a => a.Code))
                    {
                        var isDebit = account.AccountType is "Cash" or "Bank" or "Receivable";
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                            <td class="px-5 py-3 font-mono text-xs text-gray-600 dark:text-gray-400">@account.Code</td>
                            <td class="px-4 py-3 font-medium text-gray-800 dark:text-gray-200">@account.Name</td>
                            <td class="px-4 py-3">
                                @{
                                    var (tbg, ttxt, tlabel) = account.AccountType switch
                                    {
                                        "Cash"       => ("bg-green-100 dark:bg-green-900/40", "text-green-700 dark:text-green-400", "Kasa"),
                                        "Bank"       => ("bg-blue-100 dark:bg-blue-900/40", "text-blue-700 dark:text-blue-400", "Banka"),
                                        "Receivable" => ("bg-amber-100 dark:bg-amber-900/40", "text-amber-700 dark:text-amber-400", "Alacak"),
                                        "Payable"    => ("bg-red-100 dark:bg-red-900/40", "text-red-700 dark:text-red-400", "Borç"),
                                        "Revenue"    => ("bg-purple-100 dark:bg-purple-900/40", "text-purple-700 dark:text-purple-400", "Gelir"),
                                        "Expense"    => ("bg-orange-100 dark:bg-orange-900/40", "text-orange-700 dark:text-orange-400", "Gider"),
                                        _            => ("bg-gray-100 dark:bg-gray-700", "text-gray-600 dark:text-gray-400", account.AccountType)
                                    };
                                }
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium @tbg @ttxt">@tlabel</span>
                            </td>
                            <td class="px-4 py-3 text-right font-medium @(account.Balance >= 0 ? "text-gray-800 dark:text-gray-200" : "text-red-600 dark:text-red-400")">
                                @account.Balance.ToString("N2") ₺
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="bg-gray-50 dark:bg-gray-700/50 border-t-2 border-gray-200 dark:border-gray-600">
                    <tr>
                        <td colspan="3" class="px-5 py-3 text-sm font-semibold text-gray-700 dark:text-gray-300">Toplam Varlık (Kasa + Banka)</td>
                        <td class="px-4 py-3 text-right font-bold text-gray-900 dark:text-white">
                            @accounts.Where(a => a.AccountType is "Cash" or "Bank").Sum(a => a.Balance).ToString("N2") ₺
                        </td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>

    @* Hızlı Linkler *@
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href="@Url.Action("Receivables","Finance")"
           class="flex items-center gap-4 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
            <div class="w-10 h-10 rounded-lg bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
            </div>
            <div>
                <div class="text-sm font-medium text-gray-800 dark:text-gray-200">Müşteri Alacakları</div>
                <div class="text-xs text-gray-400">Vadesi gelen ve gecikmiş alacaklar</div>
            </div>
        </a>
        <a href="@Url.Action("Payables","Finance")"
           class="flex items-center gap-4 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
            <div class="w-10 h-10 rounded-lg bg-red-100 dark:bg-red-900/40 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z"/>
                </svg>
            </div>
            <div>
                <div class="text-sm font-medium text-gray-800 dark:text-gray-200">Tedarikçi Borçları</div>
                <div class="text-xs text-gray-400">Ödenmemiş tedarikçi borçları</div>
            </div>
        </a>
    </div>
</div>
