@model TeknikServis.Web.Controllers.DashboardViewModel
@using TeknikServis.Domain.Enums

<div class="flex flex-col gap-6">

    {{!-- Page title --}}
    <div>
        <h1 class="text-xl font-semibold text-gray-900 dark:text-white">Panel</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">@DateTime.Now.ToString("dd MMMM yyyy, dddd")</p>
    </div>

    {{!-- AI Alert banner --}}
    @if (Model.UnreadAiAlertCount > 0)
    {
        <div class="flex items-center gap-3 p-4 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700/40 rounded-xl">
            <svg class="w-5 h-5 text-amber-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
            </svg>
            <p class="text-sm text-amber-800 dark:text-amber-300 flex-1">
                <strong>@Model.UnreadAiAlertCount Ensar AI uyarısı</strong> okunmayı bekliyor.
            </p>
            <a href="@Url.Action("Index","AiAlert")" class="text-sm font-medium text-amber-700 dark:text-amber-300 hover:underline whitespace-nowrap">Görüntüle</a>
        </div>
    }

    {{!-- KPI Cards --}}
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">

        <a href="@Url.Action("Index","Service")" class="group bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 hover:border-blue-300 dark:hover:border-blue-600 transition-all hover:shadow-sm">
            <div class="flex items-start justify-between mb-3">
                <div class="w-9 h-9 rounded-lg bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center">
                    <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                </div>
            </div>
            <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.OpenServiceCount</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Açık Servis</p>
        </a>

        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4">
            <div class="w-9 h-9 rounded-lg bg-green-100 dark:bg-green-900/40 flex items-center justify-center mb-3">
                <svg class="w-5 h-5 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
            </div>
            <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.TodayNewCount</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Bugün Gelen</p>
        </div>

        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4">
            <div class="w-9 h-9 rounded-lg bg-teal-100 dark:bg-teal-900/40 flex items-center justify-center mb-3">
                <svg class="w-5 h-5 text-teal-600 dark:text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
            </div>
            <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.TodayDeliveredCount</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Bugün Teslim</p>
        </div>

        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4">
            <div class="w-9 h-9 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 flex items-center justify-center mb-3">
                <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.MonthRevenue.ToString("N0") ₺</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Bu Ay Gelir</p>
        </div>

        <a href="@Url.Action("Index","Service", new{status=5})"
           class="group bg-white dark:bg-gray-800 border @(Model.AwaitingApprovalCount > 0 ? "border-orange-300 dark:border-orange-700" : "border-gray-200 dark:border-gray-700") rounded-xl p-4 hover:shadow-sm transition-all">
            <div class="w-9 h-9 rounded-lg bg-orange-100 dark:bg-orange-900/40 flex items-center justify-center mb-3">
                <svg class="w-5 h-5 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <p class="text-2xl font-bold @(Model.AwaitingApprovalCount > 0 ? "text-orange-600 dark:text-orange-400" : "text-gray-900 dark:text-white")">@Model.AwaitingApprovalCount</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Onay Bekliyor</p>
        </a>

        <a href="@Url.Action("Index","Service", new{status=3})"
           class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 hover:shadow-sm transition-all">
            <div class="w-9 h-9 rounded-lg bg-amber-100 dark:bg-amber-900/40 flex items-center justify-center mb-3">
                <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                </svg>
            </div>
            <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.AwaitingPartsCount</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Parça Bekliyor</p>
        </a>

        <a href="@Url.Action("Index","Service", new{status=4})"
           class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 hover:shadow-sm transition-all">
            <div class="w-9 h-9 rounded-lg bg-purple-100 dark:bg-purple-900/40 flex items-center justify-center mb-3">
                <svg class="w-5 h-5 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
            </div>
            <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.InRepairCount</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Onarımda</p>
        </a>

        <a href="@Url.Action("Index","Purchase")"
           class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 hover:shadow-sm transition-all">
            <div class="w-9 h-9 rounded-lg bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center mb-3">
                <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
            </div>
            <p class="text-2xl font-bold text-gray-900 dark:text-white">@Model.TodayPurchaseCount</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Bugün Alış</p>
        </a>

    </div>

    {{!-- Recent Services --}}
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100 dark:border-gray-700">
            <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300">Son Servis Kayıtları</h2>
            <a href="@Url.Action("Index","Service")" class="text-sm text-blue-600 dark:text-blue-400 hover:underline">Tümünü Gör</a>
        </div>
        @if (!Model.RecentServices.Any())
        {
            <p class="text-center text-sm text-gray-400 dark:text-gray-500 py-8">Henüz kayıt yok</p>
        }
        else
        {
            <table class="w-full text-sm">
                <thead class="bg-gray-50 dark:bg-gray-700/50">
                    <tr>
                        <th class="text-left px-5 py-2.5 text-xs font-semibold text-gray-500 dark:text-gray-400">No</th>
                        <th class="text-left px-4 py-2.5 text-xs font-semibold text-gray-500 dark:text-gray-400">Müşteri</th>
                        <th class="text-left px-4 py-2.5 text-xs font-semibold text-gray-500 dark:text-gray-400">Cihaz</th>
                        <th class="text-left px-4 py-2.5 text-xs font-semibold text-gray-500 dark:text-gray-400">Durum</th>
                        <th class="text-left px-4 py-2.5 text-xs font-semibold text-gray-500 dark:text-gray-400">Tarih</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                    @foreach (var s in Model.RecentServices)
                    {
                        var (bg, txt) = GetStatusClass(s.Status);
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                            <td class="px-5 py-3">
                                <a href="@Url.Action("Detail","Service", new{id=s.Id})"
                                   class="font-mono text-xs text-blue-600 dark:text-blue-400 hover:underline">@s.RecordNumber</a>
                            </td>
                            <td class="px-4 py-3 text-gray-700 dark:text-gray-300">@s.CustomerName</td>
                            <td class="px-4 py-3 text-gray-600 dark:text-gray-400">@s.DeviceBrand @s.DeviceModel</td>
                            <td class="px-4 py-3">
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium @bg @txt">
                                    @GetStatusDisplay(s.Status)
                                </span>
                            </td>
                            <td class="px-4 py-3 text-xs text-gray-400 dark:text-gray-500">@s.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

</div>

@functions {
    static string GetStatusDisplay(ServiceStatus s) => s switch
    {
        ServiceStatus.Received => "Teslim Alındı",
        ServiceStatus.Diagnosing => "Arıza Tespiti",
        ServiceStatus.AwaitingParts => "Parça Bekleniyor",
        ServiceStatus.InRepair => "Onarımda",
        ServiceStatus.AwaitingApproval => "Onay Bekleniyor",
        ServiceStatus.Ready => "Hazır",
        ServiceStatus.Delivered => "Teslim Edildi",
        ServiceStatus.Cancelled => "İptal",
        ServiceStatus.Unrepairable => "Onarım Mümkün Değil",
        ServiceStatus.ReturnedUnrepaired => "İade",
        _ => s.ToString()
    };

    static (string bg, string txt) GetStatusClass(ServiceStatus s) => s switch
    {
        ServiceStatus.Received         => ("bg-gray-100 dark:bg-gray-700", "text-gray-700 dark:text-gray-300"),
        ServiceStatus.Diagnosing       => ("bg-blue-100 dark:bg-blue-900/40", "text-blue-700 dark:text-blue-300"),
        ServiceStatus.AwaitingParts    => ("bg-amber-100 dark:bg-amber-900/40", "text-amber-700 dark:text-amber-300"),
        ServiceStatus.InRepair         => ("bg-purple-100 dark:bg-purple-900/40", "text-purple-700 dark:text-purple-300"),
        ServiceStatus.AwaitingApproval => ("bg-orange-100 dark:bg-orange-900/40", "text-orange-700 dark:text-orange-300"),
        ServiceStatus.Ready            => ("bg-teal-100 dark:bg-teal-900/40", "text-teal-700 dark:text-teal-300"),
        ServiceStatus.Delivered        => ("bg-green-100 dark:bg-green-900/40", "text-green-700 dark:text-green-300"),
        ServiceStatus.Cancelled        => ("bg-red-100 dark:bg-red-900/40", "text-red-700 dark:text-red-300"),
        ServiceStatus.Unrepairable     => ("bg-rose-100 dark:bg-rose-900/40", "text-rose-700 dark:text-rose-300"),
        ServiceStatus.ReturnedUnrepaired => ("bg-pink-100 dark:bg-pink-900/40", "text-pink-700 dark:text-pink-300"),
        _ => ("bg-gray-100 dark:bg-gray-700", "text-gray-600 dark:text-gray-400")
    };
}
