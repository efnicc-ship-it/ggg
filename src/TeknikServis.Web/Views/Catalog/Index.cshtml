@model IEnumerable<TeknikServis.Domain.Entities.Device.DeviceType>

<div class="flex flex-col gap-5">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-xl font-semibold text-gray-900 dark:text-white">Cihaz Kataloğu</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">Tür → Marka → Model → Varyant hiyerarşisi</p>
        </div>
        <a href="@Url.Action("Faults")" class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-sm rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 whitespace-nowrap">
            Arıza & İşlem Tipleri
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 rounded-xl px-4 py-3 text-sm text-green-700 dark:text-green-400">@TempData["Success"]</div>
    }

    @* Yeni Cihaz Türü *@
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-5">
        <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">Yeni Cihaz Türü Ekle</h2>
        <form method="post" action="@Url.Action("CreateType","Catalog")" class="flex gap-3 flex-wrap">
            @Html.AntiForgeryToken()
            <input type="text" name="name" required placeholder="Örn: Telefon, Tablet, Notebook"
                   class="flex-1 min-w-40 px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
            <input type="text" name="description" placeholder="Açıklama (opsiyonel)"
                   class="flex-1 min-w-40 px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
            <input type="number" name="sortOrder" value="0" placeholder="Sıra"
                   class="w-20 px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
            <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">Ekle</button>
        </form>
    </div>

    @* Cihaz Türleri Listesi *@
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
        @if (!Model.Any())
        {
            <div class="text-center py-12 text-gray-400 dark:text-gray-500 text-sm">Cihaz türü tanımlanmamış</div>
        }
        else
        {
            <table class="w-full text-sm">
                <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                    <tr>
                        <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Cihaz Türü</th>
                        <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Marka Sayısı</th>
                        <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Model Sayısı</th>
                        <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Durum</th>
                        <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                    @foreach (var type in Model)
                    {
                        int modelCount = type.Brands.Sum(b => b.Models.Count);
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                            <td class="px-5 py-3">
                                <div class="font-medium text-gray-800 dark:text-gray-200">@type.Name</div>
                                @if (!string.IsNullOrEmpty(type.Description))
                                {
                                    <div class="text-xs text-gray-400">@type.Description</div>
                                }
                            </td>
                            <td class="px-4 py-3 text-center text-gray-600 dark:text-gray-400">@type.Brands.Count</td>
                            <td class="px-4 py-3 text-center text-gray-600 dark:text-gray-400">@modelCount</td>
                            <td class="px-4 py-3 text-center">
                                @if (type.IsActive)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-400">Aktif</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400">Pasif</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="@Url.Action("Brands","Catalog", new{typeId=type.Id})"
                                       class="px-3 py-1 text-xs bg-blue-50 dark:bg-blue-900/20 text-blue-700 dark:text-blue-400 border border-blue-200 dark:border-blue-700 rounded-lg hover:bg-blue-100 dark:hover:bg-blue-900/40 transition-colors">
                                        Markalar
                                    </a>
                                    <form method="post" action="@Url.Action("ToggleType","Catalog")" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@type.Id"/>
                                        <button type="submit" class="px-3 py-1 text-xs border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-400 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                            @(type.IsActive ? "Pasif Et" : "Aktif Et")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
