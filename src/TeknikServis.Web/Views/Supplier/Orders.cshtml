@model IEnumerable<TeknikServis.Domain.Entities.Supplier.PartOrder>
@using TeknikServis.Domain.Enums

@{
    int page = ViewBag.Page ?? 1;
    int total = ViewBag.TotalCount ?? 0;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="flex flex-col gap-5">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-xl font-semibold text-gray-900 dark:text-white">Parça Siparişleri</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">Toplam <span class="font-medium text-gray-700 dark:text-gray-300">@total</span> sipariş</p>
        </div>
        <a href="@Url.Action("Index","Supplier")" class="text-sm text-blue-600 dark:text-blue-400 hover:underline">← Tedarikçiler</a>
    </div>

    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
        @if (!Model.Any())
        {
            <div class="text-center py-16 text-gray-400 dark:text-gray-500 text-sm">Sipariş bulunamadı</div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                        <tr>
                            <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Sipariş No</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Tedarikçi</th>
                            <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Durum</th>
                            <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Toplam</th>
                            <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">WA Gönderildi</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Tarih</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                        @foreach (var order in Model)
                        {
                            var (sbg, stxt, slabel) = order.Status switch
                            {
                                PartOrderStatus.Ordered           => ("bg-blue-100 dark:bg-blue-900/40", "text-blue-700 dark:text-blue-400", "Sipariş Verildi"),
                                PartOrderStatus.PartiallyReceived  => ("bg-amber-100 dark:bg-amber-900/40", "text-amber-700 dark:text-amber-400", "Kısmi Teslim"),
                                PartOrderStatus.FullyReceived      => ("bg-green-100 dark:bg-green-900/40", "text-green-700 dark:text-green-400", "Teslim Alındı"),
                                PartOrderStatus.Returned           => ("bg-red-100 dark:bg-red-900/40", "text-red-700 dark:text-red-400", "İade Edildi"),
                                PartOrderStatus.Cancelled          => ("bg-gray-100 dark:bg-gray-700", "text-gray-600 dark:text-gray-400", "İptal"),
                                _                                  => ("bg-gray-100 dark:bg-gray-700", "text-gray-600 dark:text-gray-400", order.Status.ToString())
                            };
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                                <td class="px-5 py-3 font-mono text-xs font-medium text-gray-800 dark:text-gray-200">@order.OrderNumber</td>
                                <td class="px-4 py-3 text-gray-700 dark:text-gray-300">@order.Supplier.CompanyName</td>
                                <td class="px-4 py-3 text-center">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium @sbg @stxt">@slabel</span>
                                </td>
                                <td class="px-4 py-3 text-right font-medium text-gray-800 dark:text-gray-200">@order.TotalAmount.ToString("N2") ₺</td>
                                <td class="px-4 py-3 text-center">
                                    @if (order.WhatsAppSent)
                                    {
                                        <svg class="w-4 h-4 text-green-500 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                                        </svg>
                                    }
                                    else
                                    {
                                        <span class="text-gray-300 dark:text-gray-600">—</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-xs text-gray-400 dark:text-gray-500">@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="flex justify-end gap-1 px-4 py-3 border-t border-gray-100 dark:border-gray-700">
                    @for (int p = Math.Max(1, page - 2); p <= Math.Min(totalPages, page + 2); p++)
                    {
                        <a href="@Url.Action("Orders","Supplier", new{page=p})"
                           class="px-3 py-1.5 text-sm border rounded-lg @(p == page ? "bg-blue-600 border-blue-600 text-white" : "border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300")">@p</a>
                    }
                </div>
            }
        }
    </div>
</div>
