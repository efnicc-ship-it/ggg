@model TeknikServis.Application.Features.Service.Queries.GetServiceRecordDetail.ServiceRecordDetailDto
@using TeknikServis.Domain.Enums

@{
    var statusColor = Model.StatusColor;
}

<div class="flex flex-col gap-5">

    {{!-- Header --}}
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-3 flex-wrap">
                <h1 class="text-xl font-semibold text-gray-900 dark:text-white font-mono">@Model.RecordNumber</h1>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium @Model.StatusColor">
                    @Model.StatusDisplay
                </span>
                @if (Model.IsUnderWarranty)
                {
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-400">Garanti</span>
                }
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                Açılış: @Model.CreatedAt.ToString("dd MMMM yyyy HH:mm")
                &nbsp;·&nbsp; @Model.DaysOpen gün açık
                @if (Model.DeliveredAt.HasValue)
                {
                    <span>&nbsp;·&nbsp; Teslim: @Model.DeliveredAt.Value.ToString("dd.MM.yyyy")</span>
                }
            </p>
        </div>
        <div class="flex flex-wrap gap-2">
            <button onclick="document.getElementById('statusModal').classList.remove('hidden')"
                    class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">
                Durum Güncelle
            </button>
            <button onclick="document.getElementById('partModal').classList.remove('hidden')"
                    class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white text-sm font-medium rounded-lg transition-colors">
                Parça Ekle
            </button>
            <form method="post" action="@Url.Action("PrintLabel","Service")" class="inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id"/>
                <button type="submit" class="px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 text-sm font-medium rounded-lg transition-colors">
                    Etiket Bas
                </button>
            </form>
            <button onclick="document.getElementById('paymentModal').classList.remove('hidden')"
                    class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg transition-colors">
                Ödeme Al
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

        {{!-- Left column --}}
        <div class="lg:col-span-2 flex flex-col gap-5">

            {{!-- Cihaz Bilgileri --}}
            <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-5">
                <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wide mb-4">Cihaz Bilgileri</h2>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                    <div>
                        <p class="text-xs text-gray-400 dark:text-gray-500">Marka / Model</p>
                        <p class="text-sm font-medium text-gray-900 dark:text-white mt-0.5">@Model.DeviceBrand @Model.DeviceModel</p>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.DeviceVariant))
                    {
                        <div>
                            <p class="text-xs text-gray-400 dark:text-gray-500">Varyant</p>
                            <p class="text-sm font-medium text-gray-900 dark:text-white mt-0.5">@Model.DeviceVariant</p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.DeviceColor))
                    {
                        <div>
                            <p class="text-xs text-gray-400 dark:text-gray-500">Renk</p>
                            <p class="text-sm font-medium text-gray-900 dark:text-white mt-0.5">@Model.DeviceColor</p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Imei1))
                    {
                        <div>
                            <p class="text-xs text-gray-400 dark:text-gray-500">IMEI 1</p>
                            <p class="text-sm font-medium text-gray-900 dark:text-white font-mono mt-0.5">@Model.Imei1</p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Imei2))
                    {
                        <div>
                            <p class="text-xs text-gray-400 dark:text-gray-500">IMEI 2</p>
                            <p class="text-sm font-medium text-gray-900 dark:text-white font-mono mt-0.5">@Model.Imei2</p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.SerialNumber))
                    {
                        <div>
                            <p class="text-xs text-gray-400 dark:text-gray-500">Seri No</p>
                            <p class="text-sm font-medium text-gray-900 dark:text-white font-mono mt-0.5">@Model.SerialNumber</p>
                        </div>
                    }
                </div>
                <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700">
                    <p class="text-xs text-gray-400 dark:text-gray-500 mb-1">Arıza Açıklaması</p>
                    <p class="text-sm text-gray-800 dark:text-gray-200">@Model.FaultDescription</p>
                </div>
                @if (!string.IsNullOrEmpty(Model.InternalNotes))
                {
                    <div class="mt-3 p-3 bg-amber-50 dark:bg-amber-900/20 rounded-lg border border-amber-200 dark:border-amber-700/40">
                        <p class="text-xs font-medium text-amber-700 dark:text-amber-400 mb-1">Dahili Not</p>
                        <p class="text-sm text-amber-800 dark:text-amber-300">@Model.InternalNotes</p>
                    </div>
                }
            </div>

            {{!-- Parçalar --}}
            <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
                <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100 dark:border-gray-700">
                    <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wide">Parçalar / Malzemeler</h2>
                    <button onclick="document.getElementById('partModal').classList.remove('hidden')"
                            class="text-sm text-blue-600 dark:text-blue-400 hover:underline">+ Ekle</button>
                </div>
                @if (!Model.Parts.Any())
                {
                    <p class="text-center text-sm text-gray-400 dark:text-gray-500 py-8">Henüz parça eklenmedi</p>
                }
                else
                {
                    <table class="w-full text-sm">
                        <thead class="bg-gray-50 dark:bg-gray-700/50">
                            <tr>
                                <th class="text-left px-5 py-2.5 text-xs font-semibold text-gray-500 dark:text-gray-400">Parça</th>
                                <th class="text-center px-4 py-2.5 text-xs font-semibold text-gray-500 dark:text-gray-400">Adet</th>
                                <th class="text-right px-5 py-2.5 text-xs font-semibold text-gray-500 dark:text-gray-400">Birim</th>
                                <th class="text-right px-5 py-2.5 text-xs font-semibold text-gray-500 dark:text-gray-400">Toplam</th>
                                <th class="text-center px-4 py-2.5 text-xs font-semibold text-gray-500 dark:text-gray-400">Durum</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                            @foreach (var part in Model.Parts)
                            {
                                <tr class="@(part.IsWrittenOff ? "bg-red-50 dark:bg-red-900/10" : part.IsReplacementOrder ? "bg-amber-50 dark:bg-amber-900/10" : "")">
                                    <td class="px-5 py-3 font-medium text-gray-800 dark:text-gray-200">@part.PartName</td>
                                    <td class="px-4 py-3 text-center text-gray-600 dark:text-gray-300">@part.Quantity</td>
                                    <td class="px-5 py-3 text-right text-gray-600 dark:text-gray-300">@part.UnitCost.ToString("N2") ₺</td>
                                    <td class="px-5 py-3 text-right font-medium text-gray-800 dark:text-gray-200">@part.TotalCost.ToString("N2") ₺</td>
                                    <td class="px-4 py-3 text-center">
                                        @if (part.IsWrittenOff)
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-400">Fire</span>
                                        }
                                        else if (part.IsReplacementOrder)
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-400">Yeniden Sipariş</span>
                                        }
                                        else
                                        {
                                            <span class="text-gray-400 dark:text-gray-500 text-xs">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bg-gray-50 dark:bg-gray-700/50 border-t border-gray-200 dark:border-gray-700">
                            <tr>
                                <td colspan="3" class="px-5 py-2.5 text-xs font-semibold text-gray-500 dark:text-gray-400 text-right">Toplam Parça Maliyeti</td>
                                <td class="px-5 py-2.5 text-right font-bold text-gray-900 dark:text-white">@Model.PartsCost.ToString("N2") ₺</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                }
            </div>

            {{!-- Notlar --}}
            <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
                <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100 dark:border-gray-700">
                    <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wide">Notlar</h2>
                    <button onclick="document.getElementById('noteModal').classList.remove('hidden')"
                            class="text-sm text-blue-600 dark:text-blue-400 hover:underline">+ Not Ekle</button>
                </div>
                @if (!Model.Notes.Any())
                {
                    <p class="text-center text-sm text-gray-400 dark:text-gray-500 py-8">Henüz not eklenmedi</p>
                }
                else
                {
                    <div class="divide-y divide-gray-100 dark:divide-gray-700">
                        @foreach (var note in Model.Notes.OrderByDescending(n => n.CreatedAt))
                        {
                            <div class="px-5 py-4">
                                <div class="flex items-center justify-between mb-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium text-gray-800 dark:text-gray-200">@(note.AuthorName ?? "Sistem")</span>
                                        @if (note.IsInternal)
                                        {
                                            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-700 dark:bg-yellow-900/40 dark:text-yellow-400">Dahili</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-400">Müşteri</span>
                                        }
                                    </div>
                                    <span class="text-xs text-gray-400 dark:text-gray-500">@note.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                </div>
                                <p class="text-sm text-gray-600 dark:text-gray-300">@note.Content</p>
                            </div>
                        }
                    </div>
                }
            </div>

            {{!-- Medya --}}
            @if (Model.Media.Any())
            {
                <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-5">
                    <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wide mb-4">Medya</h2>
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
                        @foreach (var media in Model.Media)
                        {
                            <div class="relative group">
                                <a href="@media.FilePath" target="_blank" class="block">
                                    <div class="aspect-square bg-gray-100 dark:bg-gray-700 rounded-lg overflow-hidden">
                                        @if (media.FileType.StartsWith("image/"))
                                        {
                                            <img src="@media.FilePath" alt="@media.Caption" class="w-full h-full object-cover group-hover:opacity-80 transition-opacity"/>
                                        }
                                        else
                                        {
                                            <div class="w-full h-full flex items-center justify-center">
                                                <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.069A1 1 0 0121 8.82v6.36a1 1 0 01-1.447.894L15 14M3 8a2 2 0 012-2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8z"/>
                                                </svg>
                                            </div>
                                        }
                                    </div>
                                </a>
                                <div class="absolute top-1 left-1">
                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium @(media.IsBefore ? "bg-red-100 text-red-700" : "bg-green-100 text-green-700")">
                                        @(media.IsBefore ? "Önce" : "Sonra")
                                    </span>
                                </div>
                                @if (!string.IsNullOrEmpty(media.Caption))
                                {
                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 truncate">@media.Caption</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

        </div>

        {{!-- Right column --}}
        <div class="flex flex-col gap-5">

            {{!-- Müşteri Bilgileri --}}
            <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-5">
                <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wide mb-4">Müşteri</h2>
                <div class="space-y-2">
                    <p class="font-semibold text-gray-900 dark:text-white">@Model.CustomerName</p>
                    <a href="tel:@Model.CustomerPhone" class="block text-sm text-blue-600 dark:text-blue-400 hover:underline">@Model.CustomerPhone</a>
                    @if (!string.IsNullOrEmpty(Model.CustomerEmail))
                    {
                        <a href="mailto:@Model.CustomerEmail" class="block text-sm text-blue-600 dark:text-blue-400 hover:underline">@Model.CustomerEmail</a>
                    }
                </div>
                @if (!string.IsNullOrEmpty(Model.ApprovalToken))
                {
                    <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700">
                        <p class="text-xs text-gray-400 dark:text-gray-500 mb-2">Müşteri Takip Linki</p>
                        <div class="flex gap-2">
                            <input type="text" readonly
                                   value="@($"{ViewBag.BaseUrl}/servis/{Model.ApprovalToken}")"
                                   class="flex-1 text-xs px-2 py-1.5 border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-600 dark:text-gray-300 font-mono"/>
                            <button onclick="copyToClipboard('@($"{ViewBag.BaseUrl}/servis/{Model.ApprovalToken}")')"
                                    class="px-2 py-1.5 border border-gray-200 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 text-xs text-gray-600 dark:text-gray-300 transition-colors">
                                Kopyala
                            </button>
                        </div>
                    </div>
                }
            </div>

            {{!-- Teknisyen --}}
            <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-5">
                <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wide mb-3">Teknisyen</h2>
                <p class="text-gray-800 dark:text-gray-200">@(Model.TechnicianName ?? "Atanmadı")</p>
                @if (Model.TimeLogs.Any())
                {
                    <div class="mt-3 pt-3 border-t border-gray-100 dark:border-gray-700">
                        <p class="text-xs text-gray-400 dark:text-gray-500 mb-2">Çalışma Süreleri</p>
                        @foreach (var log in Model.TimeLogs)
                        {
                            <div class="flex justify-between text-xs text-gray-600 dark:text-gray-300 mb-1">
                                <span>@log.TechnicianName</span>
                                <span>@(log.DurationMinutes.HasValue ? $"{log.DurationMinutes}dk" : "Devam ediyor")</span>
                            </div>
                        }
                    </div>
                }
            </div>

            {{!-- Fiyat & Ödeme --}}
            <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-5">
                <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wide mb-4">Fiyat & Ödeme</h2>
                <div class="space-y-3">
                    @if (Model.QuotedPrice.HasValue)
                    {
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-500 dark:text-gray-400">Teklif Fiyatı</span>
                            <span class="text-gray-800 dark:text-gray-200">@Model.QuotedPrice.Value.ToString("N2") ₺</span>
                        </div>
                    }
                    @if (Model.FinalPrice.HasValue)
                    {
                        <div class="flex justify-between text-sm font-medium">
                            <span class="text-gray-700 dark:text-gray-300">Nihai Fiyat</span>
                            <span class="text-gray-900 dark:text-white">@Model.FinalPrice.Value.ToString("N2") ₺</span>
                        </div>
                    }
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-500 dark:text-gray-400">Ödenen</span>
                        <span class="text-green-600 dark:text-green-400 font-medium">@Model.TotalPaid.ToString("N2") ₺</span>
                    </div>
                    @if (Model.FinalPrice.HasValue && Model.TotalPaid < Model.FinalPrice.Value)
                    {
                        <div class="flex justify-between text-sm font-semibold border-t border-gray-100 dark:border-gray-700 pt-2">
                            <span class="text-gray-700 dark:text-gray-300">Kalan</span>
                            <span class="text-red-600 dark:text-red-400">@((Model.FinalPrice.Value - Model.TotalPaid).ToString("N2")) ₺</span>
                        </div>
                    }
                    <div class="pt-2 border-t border-gray-100 dark:border-gray-700">
                        <div class="flex justify-between text-xs">
                            <span class="text-gray-400 dark:text-gray-500">Parça Maliyeti</span>
                            <span class="text-gray-500 dark:text-gray-400">@Model.PartsCost.ToString("N2") ₺</span>
                        </div>
                        <div class="flex justify-between text-xs mt-1">
                            <span class="text-gray-400 dark:text-gray-500">İşçilik</span>
                            <span class="text-gray-500 dark:text-gray-400">@Model.LaborCost.ToString("N2") ₺</span>
                        </div>
                        <div class="flex justify-between text-xs mt-1 font-medium">
                            <span class="text-gray-500 dark:text-gray-400">Net Kâr</span>
                            <span class="@(Model.NetProfit >= 0 ? "text-green-600 dark:text-green-400" : "text-red-600 dark:text-red-400")">@Model.NetProfit.ToString("N2") ₺</span>
                        </div>
                    </div>
                    @if (Model.PriceApproved.HasValue)
                    {
                        <div class="text-xs @(Model.PriceApproved.Value ? "text-green-600 dark:text-green-400" : "text-red-600 dark:text-red-400")">
                            Fiyat @(Model.PriceApproved.Value ? "Onaylandı" : "Reddedildi")
                        </div>
                    }
                </div>

                {{!-- Ödeme Geçmişi --}}
                @if (Model.Payments.Any())
                {
                    <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700">
                        <p class="text-xs text-gray-400 dark:text-gray-500 mb-2">Ödeme Geçmişi</p>
                        @foreach (var payment in Model.Payments)
                        {
                            <div class="flex justify-between text-xs mb-1">
                                <span class="text-gray-500 dark:text-gray-400">@payment.PaymentMethod · @payment.CreatedAt.ToString("dd.MM.yyyy")</span>
                                <span class="text-green-600 dark:text-green-400 font-medium">@payment.Amount.ToString("N2") ₺</span>
                            </div>
                        }
                    </div>
                }
            </div>

            {{!-- Durum Geçmişi (Timeline) --}}
            <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-5">
                <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wide mb-4">Durum Geçmişi</h2>
                @if (!Model.StatusHistory.Any())
                {
                    <p class="text-sm text-gray-400 dark:text-gray-500">Kayıt yok</p>
                }
                else
                {
                    <div class="relative">
                        <div class="absolute left-3 top-0 bottom-0 w-px bg-gray-200 dark:bg-gray-700"></div>
                        <div class="space-y-4">
                            @foreach (var history in Model.StatusHistory.OrderByDescending(h => h.ChangedAt))
                            {
                                <div class="relative flex gap-3">
                                    <div class="w-6 h-6 rounded-full bg-blue-100 dark:bg-blue-900/40 border-2 border-blue-500 flex-shrink-0 z-10"></div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm text-gray-800 dark:text-gray-200">
                                            <span class="font-medium">@GetStatusDisplay(history.NewStatus)</span>
                                        </p>
                                        @if (!string.IsNullOrEmpty(history.Note))
                                        {
                                            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@history.Note</p>
                                        }
                                        <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">@history.ChangedAt.ToString("dd.MM.yyyy HH:mm")</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

{{!-- Status Update Modal --}}
<div id="statusModal" class="hidden fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="document.getElementById('statusModal').classList.add('hidden')"></div>
    <div class="relative bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 w-full max-w-md mx-4 shadow-xl">
        <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-4">Durum Güncelle</h3>
        <form method="post" action="@Url.Action("UpdateStatus","Service")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ServiceRecordId" value="@Model.Id"/>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm text-gray-700 dark:text-gray-300 mb-1.5">Yeni Durum</label>
                    <select name="NewStatus" required
                            class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                        @foreach (ServiceStatus s in Enum.GetValues(typeof(ServiceStatus)))
                        {
                            if (s == Model.Status)
                            {
                                <option value="@((int)s)" selected>@GetStatusDisplay(s)</option>
                            }
                            else
                            {
                                <option value="@((int)s)">@GetStatusDisplay(s)</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm text-gray-700 dark:text-gray-300 mb-1.5">Not (isteğe bağlı)</label>
                    <textarea name="Note" rows="3" placeholder="Durum notu..."
                              class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"></textarea>
                </div>
            </div>
            <div class="flex gap-3 mt-5">
                <button type="button" onclick="document.getElementById('statusModal').classList.add('hidden')"
                        class="flex-1 py-2 border border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg text-sm hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">İptal</button>
                <button type="submit" class="flex-1 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition-colors">Güncelle</button>
            </div>
        </form>
    </div>
</div>

{{!-- Add Part Modal --}}
<div id="partModal" class="hidden fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="document.getElementById('partModal').classList.add('hidden')"></div>
    <div class="relative bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 w-full max-w-md mx-4 shadow-xl">
        <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-4">Parça Ekle</h3>
        <form method="post" action="@Url.Action("AddPart","Service")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ServiceRecordId" value="@Model.Id"/>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm text-gray-700 dark:text-gray-300 mb-1.5">Parça Adı</label>
                    <input type="text" name="PartName" required placeholder="örn. LCD Ekran"
                           class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm text-gray-700 dark:text-gray-300 mb-1.5">Adet</label>
                        <input type="number" name="Quantity" value="1" min="1" required
                               class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                    </div>
                    <div>
                        <label class="block text-sm text-gray-700 dark:text-gray-300 mb-1.5">Birim Maliyet (₺)</label>
                        <input type="number" name="UnitCost" step="0.01" min="0" required placeholder="0.00"
                               class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                    </div>
                </div>
                <div class="flex items-center gap-3 p-3 bg-amber-50 dark:bg-amber-900/20 rounded-lg border border-amber-200 dark:border-amber-700/40">
                    <input type="checkbox" name="IsReplacementOrder" value="true" id="isReplacement"
                           class="w-4 h-4 text-amber-600 rounded border-amber-300"/>
                    <label for="isReplacement" class="text-sm text-amber-800 dark:text-amber-300">
                        <span class="font-medium">Fire / Yeniden Sipariş</span>
                        <span class="text-xs text-amber-600 dark:text-amber-400 block">Bir parça takılırken bozuldu, yenisi sipariş edildi</span>
                    </label>
                </div>
            </div>
            <div class="flex gap-3 mt-5">
                <button type="button" onclick="document.getElementById('partModal').classList.add('hidden')"
                        class="flex-1 py-2 border border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg text-sm hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">İptal</button>
                <button type="submit" class="flex-1 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg text-sm font-medium transition-colors">Ekle</button>
            </div>
        </form>
    </div>
</div>

{{!-- Note Modal --}}
<div id="noteModal" class="hidden fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="document.getElementById('noteModal').classList.add('hidden')"></div>
    <div class="relative bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 w-full max-w-md mx-4 shadow-xl">
        <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-4">Not Ekle</h3>
        <form method="post" action="@Url.Action("AddNote","Service")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ServiceRecordId" value="@Model.Id"/>
            <div class="space-y-4">
                <div>
                    <textarea name="Content" rows="4" required placeholder="Not içeriği..."
                              class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"></textarea>
                </div>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" name="IsInternal" value="true"
                           class="w-4 h-4 text-amber-600 rounded border-gray-300"/>
                    <span class="text-sm text-gray-700 dark:text-gray-300">Dahili not (müşteri göremez)</span>
                </label>
            </div>
            <div class="flex gap-3 mt-5">
                <button type="button" onclick="document.getElementById('noteModal').classList.add('hidden')"
                        class="flex-1 py-2 border border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg text-sm hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">İptal</button>
                <button type="submit" class="flex-1 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition-colors">Kaydet</button>
            </div>
        </form>
    </div>
</div>

{{!-- Payment Modal --}}
<div id="paymentModal" class="hidden fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="document.getElementById('paymentModal').classList.add('hidden')"></div>
    <div class="relative bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 w-full max-w-md mx-4 shadow-xl">
        <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-4">Ödeme Al</h3>
        <form method="post" action="@Url.Action("AddPayment","Service")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ServiceRecordId" value="@Model.Id"/>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm text-gray-700 dark:text-gray-300 mb-1.5">Tutar (₺)</label>
                    <input type="number" name="Amount" step="0.01" min="0.01" required placeholder="0.00"
                           class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                </div>
                <div>
                    <label class="block text-sm text-gray-700 dark:text-gray-300 mb-1.5">Ödeme Yöntemi</label>
                    <select name="PaymentMethod" required
                            class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="Nakit">Nakit</option>
                        <option value="Kredi Kartı">Kredi Kartı</option>
                        <option value="Havale/EFT">Havale/EFT</option>
                        <option value="QR Ödeme">QR Ödeme</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm text-gray-700 dark:text-gray-300 mb-1.5">Not</label>
                    <input type="text" name="Note" placeholder="isteğe bağlı..."
                           class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                </div>
            </div>
            <div class="flex gap-3 mt-5">
                <button type="button" onclick="document.getElementById('paymentModal').classList.add('hidden')"
                        class="flex-1 py-2 border border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg text-sm hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">İptal</button>
                <button type="submit" class="flex-1 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg text-sm font-medium transition-colors">Kaydet</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                window.showToast && window.showToast('Bağlantı kopyalandı', 'success');
            });
        }
    </script>
}

@functions {
    static string GetStatusDisplay(ServiceStatus s) => s switch
    {
        ServiceStatus.Received => "Teslim Alındı",
        ServiceStatus.Diagnosing => "Arıza Tespiti",
        ServiceStatus.AwaitingParts => "Parça Bekleniyor",
        ServiceStatus.InRepair => "Onarımda",
        ServiceStatus.AwaitingApproval => "Onay Bekleniyor",
        ServiceStatus.Ready => "Hazır",
        ServiceStatus.Delivered => "Teslim Edildi",
        ServiceStatus.Cancelled => "İptal",
        ServiceStatus.Unrepairable => "Onarım Mümkün Değil",
        ServiceStatus.ReturnedUnrepaired => "İade (Onarılmadan)",
        _ => s.ToString()
    };
}
