@{
    Layout = null;
    bool approved = ViewBag.Approved == true;
    string recordNumber = ViewBag.RecordNumber ?? "";
    string token = ViewBag.Token ?? "";
}
<!DOCTYPE html>
<html lang="tr" class="h-full">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="robots" content="noindex, nofollow"/>
    <title>@(approved ? "Onaylandı" : "Reddedildi") — @recordNumber</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-full bg-gradient-to-br from-slate-100 to-blue-50 flex items-center justify-center p-4">

    <div class="w-full max-w-md text-center">

        @if (approved)
        {
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-green-100 mb-6">
                <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-slate-800 mb-2">Onarım Onaylandı</h1>
            <p class="text-slate-500 mb-6">
                Teşekkürler! Cihazınızın onarımı için verdiğiniz onay alındı.
                Teknisyenimiz en kısa sürede çalışmaya başlayacak.
            </p>
            <div class="bg-green-50 border border-green-200 rounded-xl p-4 mb-6">
                <p class="text-sm text-green-700">
                    Servis numaranız: <strong class="font-mono">@recordNumber</strong>
                </p>
                <p class="text-xs text-green-600 mt-1">Cihazınız hazır olduğunda SMS ile bilgilendirileceksiniz.</p>
            </div>
        }
        else
        {
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-red-100 mb-6">
                <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-slate-800 mb-2">Onarım Reddedildi</h1>
            <p class="text-slate-500 mb-6">
                Talebiniz alındı. Cihazınız onarılmadan iade hazırlığına alınacak.
                Servis ekibimiz sizi arayacaktır.
            </p>
            <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-6">
                <p class="text-sm text-red-700">
                    Servis numaranız: <strong class="font-mono">@recordNumber</strong>
                </p>
                <p class="text-xs text-red-600 mt-1">Herhangi bir sorunuz varsa bizi arayabilirsiniz.</p>
            </div>
        }

        <a href="@Url.Action("PublicQuery","Service", new{token})"
           class="inline-flex items-center gap-2 px-5 py-2.5 border border-slate-300 text-slate-600 hover:bg-slate-50 rounded-xl text-sm font-medium transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Servis Takibine Dön
        </a>

    </div>
</body>
</html>
