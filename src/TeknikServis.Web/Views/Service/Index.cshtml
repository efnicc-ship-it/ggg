@model TeknikServis.Application.Features.Service.Queries.GetServiceRecords.GetServiceRecordsResult
@using TeknikServis.Domain.Enums

@{
    var q = ViewBag.Q as string;
    var status = ViewBag.Status as ServiceStatus?;
    var from = ViewBag.From as string;
    var to = ViewBag.To as string;
    int currentPage = Model.Page;
    int totalPages = Model.TotalPages;
}

<div class="flex flex-col gap-5">

    
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-xl font-semibold text-gray-900 dark:text-white">Servis Kayıtları</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">
                Toplam <span class="font-medium text-gray-700 dark:text-gray-300">@Model.TotalCount</span> kayıt
            </p>
        </div>
        <a href="@Url.Action("Create", "Service")"
           class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Yeni Servis
        </a>
    </div>

    
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4">
        <form method="get" action="@Url.Action("Index", "Service")" class="flex flex-col sm:flex-row gap-3">
            <div class="flex-1 relative">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0"/>
                </svg>
                <input type="text" name="q" value="@q" placeholder="Servis no, müşteri, IMEI ara..."
                       class="w-full pl-9 pr-4 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"/>
            </div>
            <select name="status"
                    class="px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="">Tüm Durumlar</option>
                @foreach (ServiceStatus s in Enum.GetValues(typeof(ServiceStatus)))
                {
                    <option value="@((int)s)" selected="@(status == s ? "selected" : null)">@GetStatusDisplay(s)</option>
                }
            </select>
            <input type="date" name="from" value="@from"
                   class="px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
            <input type="date" name="to" value="@to"
                   class="px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
            <button type="submit"
                    class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors whitespace-nowrap">
                Filtrele
            </button>
            @if (!string.IsNullOrEmpty(q) || status.HasValue || !string.IsNullOrEmpty(from) || !string.IsNullOrEmpty(to))
            {
                <a href="@Url.Action("Index", "Service")"
                   class="px-4 py-2 border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 text-sm font-medium rounded-lg transition-colors whitespace-nowrap">
                    Temizle
                </a>
            }
        </form>
    </div>

    
    <div class="flex flex-wrap gap-2">
        <a href="@Url.Action("Index","Service", new{q,from,to})"
           class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium @(status == null ? "bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300" : "bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600") transition-colors">
            Tümü
        </a>
        @foreach (ServiceStatus s in Enum.GetValues(typeof(ServiceStatus)))
        {
            var (bg, txt) = GetStatusBadgeClass(s);
            <a href="@Url.Action("Index","Service", new{q, status=((int)s), from, to})"
               class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium @(status == s ? $"{bg} {txt}" : "bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600") transition-colors">
                @GetStatusDisplay(s)
            </a>
        }
    </div>

    
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
        @if (!Model.Items.Any())
        {
            <div class="flex flex-col items-center justify-center py-16 text-center">
                <svg class="w-12 h-12 text-gray-300 dark:text-gray-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
                <p class="text-gray-500 dark:text-gray-400 font-medium">Kayıt bulunamadı</p>
                <p class="text-gray-400 dark:text-gray-500 text-sm mt-1">Filtrelerinizi değiştirmeyi veya yeni kayıt oluşturmayı deneyin</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                        <tr>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Servis No</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Müşteri</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Cihaz</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Durum</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Ödeme</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Teknisyen</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Gün</th>
                            <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                        @foreach (var item in Model.Items)
                        {
                            var (badgeBg, badgeTxt) = GetStatusBadgeClass(item.Status);
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                                <td class="px-4 py-3">
                                    <div class="flex items-center gap-2">
                                        <a href="@Url.Action("Detail", "Service", new { id = item.Id })"
                                           class="font-mono text-blue-600 dark:text-blue-400 hover:underline font-medium text-xs">
                                            @item.RecordNumber
                                        </a>
                                        @if (item.IsWarrantyService)
                                        {
                                            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-400">GAR</span>
                                        }
                                        @if (!item.LabelPrinted)
                                        {
                                            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-400">Etiket</span>
                                        }
                                    </div>
                                    <div class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
                                </td>
                                <td class="px-4 py-3">
                                    <div class="font-medium text-gray-900 dark:text-white">@item.CustomerName</div>
                                    <div class="text-xs text-gray-400 dark:text-gray-500">@item.CustomerPhone</div>
                                </td>
                                <td class="px-4 py-3">
                                    <div class="text-gray-800 dark:text-gray-200">@item.DeviceBrand @item.DeviceModel</div>
                                </td>
                                <td class="px-4 py-3">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium @badgeBg @badgeTxt">
                                        @item.StatusDisplay
                                    </span>
                                </td>
                                <td class="px-4 py-3">
                                    @{
                                        var (pBg, pTxt) = GetPaymentBadgeClass(item.PaymentStatus);
                                    }
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium @pBg @pTxt">
                                        @GetPaymentDisplay(item.PaymentStatus)
                                    </span>
                                    @if (item.FinalPrice.HasValue && item.FinalPrice > 0)
                                    {
                                        <div class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">@item.FinalPrice.Value.ToString("N2") TL</div>
                                    }
                                </td>
                                <td class="px-4 py-3">
                                    <span class="text-gray-600 dark:text-gray-300 text-xs">@(item.TechnicianName ?? "—")</span>
                                </td>
                                <td class="px-4 py-3">
                                    <span class="@(item.DaysOpen > 7 ? "text-red-500 font-semibold" : item.DaysOpen > 3 ? "text-amber-500" : "text-gray-500 dark:text-gray-400") text-sm">
                                        @item.DaysOpen
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-right">
                                    <a href="@Url.Action("Detail", "Service", new { id = item.Id })"
                                       class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-200 text-sm font-medium">
                                        Detay
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            
            @if (totalPages > 1)
            {
                <div class="flex items-center justify-between px-4 py-3 border-t border-gray-100 dark:border-gray-700">
                    <p class="text-sm text-gray-500 dark:text-gray-400">
                        @((currentPage - 1) * Model.PageSize + 1)–@(Math.Min(currentPage * Model.PageSize, Model.TotalCount)) / @Model.TotalCount kayıt
                    </p>
                    <div class="flex gap-1">
                        @if (currentPage > 1)
                        {
                            <a href="@Url.Action("Index","Service", new{q, status=status.HasValue?(int?)((int)status):null, from, to, page=currentPage-1})"
                               class="px-3 py-1.5 text-sm border border-gray-200 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 transition-colors">
                                Önceki
                            </a>
                        }
                        @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                        {
                            <a href="@Url.Action("Index","Service", new{q, status=status.HasValue?(int?)((int)status):null, from, to, page=p})"
                               class="px-3 py-1.5 text-sm border rounded-lg transition-colors @(p == currentPage ? "bg-blue-600 border-blue-600 text-white" : "border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300")">
                                @p
                            </a>
                        }
                        @if (currentPage < totalPages)
                        {
                            <a href="@Url.Action("Index","Service", new{q, status=status.HasValue?(int?)((int)status):null, from, to, page=currentPage+1})"
                               class="px-3 py-1.5 text-sm border border-gray-200 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 transition-colors">
                                Sonraki
                            </a>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@functions {
    static string GetStatusDisplay(ServiceStatus s) => s switch
    {
        ServiceStatus.Received => "Teslim Alındı",
        ServiceStatus.Diagnosing => "Arıza Tespiti",
        ServiceStatus.AwaitingParts => "Parça Bekleniyor",
        ServiceStatus.InRepair => "Onarımda",
        ServiceStatus.AwaitingApproval => "Onay Bekleniyor",
        ServiceStatus.Ready => "Hazır",
        ServiceStatus.Delivered => "Teslim Edildi",
        ServiceStatus.Cancelled => "İptal",
        ServiceStatus.Unrepairable => "Onarım Mümkün Değil",
        ServiceStatus.ReturnedUnrepaired => "İade (Onarılmadan)",
        _ => s.ToString()
    };

    static (string bg, string txt) GetStatusBadgeClass(ServiceStatus s) => s switch
    {
        ServiceStatus.Received        => ("bg-gray-100 dark:bg-gray-700", "text-gray-700 dark:text-gray-300"),
        ServiceStatus.Diagnosing      => ("bg-blue-100 dark:bg-blue-900/40", "text-blue-700 dark:text-blue-300"),
        ServiceStatus.AwaitingParts   => ("bg-amber-100 dark:bg-amber-900/40", "text-amber-700 dark:text-amber-300"),
        ServiceStatus.InRepair        => ("bg-purple-100 dark:bg-purple-900/40", "text-purple-700 dark:text-purple-300"),
        ServiceStatus.AwaitingApproval=> ("bg-orange-100 dark:bg-orange-900/40", "text-orange-700 dark:text-orange-300"),
        ServiceStatus.Ready           => ("bg-teal-100 dark:bg-teal-900/40", "text-teal-700 dark:text-teal-300"),
        ServiceStatus.Delivered       => ("bg-green-100 dark:bg-green-900/40", "text-green-700 dark:text-green-300"),
        ServiceStatus.Cancelled       => ("bg-red-100 dark:bg-red-900/40", "text-red-700 dark:text-red-300"),
        ServiceStatus.Unrepairable    => ("bg-rose-100 dark:bg-rose-900/40", "text-rose-700 dark:text-rose-300"),
        ServiceStatus.ReturnedUnrepaired => ("bg-pink-100 dark:bg-pink-900/40", "text-pink-700 dark:text-pink-300"),
        _ => ("bg-gray-100 dark:bg-gray-700", "text-gray-600 dark:text-gray-400")
    };

    static string GetPaymentDisplay(PaymentStatus p) => p switch
    {
        PaymentStatus.Unpaid => "Ödenmedi",
        PaymentStatus.PartiallyPaid => "Kısmi Ödeme",
        PaymentStatus.Paid => "Ödendi",
        PaymentStatus.Deferred => "Vadeli",
        PaymentStatus.OnlinePaymentPending => "Online Bekliyor",
        _ => p.ToString()
    };

    static (string bg, string txt) GetPaymentBadgeClass(PaymentStatus p) => p switch
    {
        PaymentStatus.Paid              => ("bg-green-100 dark:bg-green-900/40", "text-green-700 dark:text-green-400"),
        PaymentStatus.PartiallyPaid     => ("bg-amber-100 dark:bg-amber-900/40", "text-amber-700 dark:text-amber-400"),
        PaymentStatus.Unpaid            => ("bg-red-100 dark:bg-red-900/40", "text-red-700 dark:text-red-400"),
        PaymentStatus.Deferred          => ("bg-blue-100 dark:bg-blue-900/40", "text-blue-700 dark:text-blue-400"),
        PaymentStatus.OnlinePaymentPending => ("bg-purple-100 dark:bg-purple-900/40", "text-purple-700 dark:text-purple-400"),
        _ => ("bg-gray-100 dark:bg-gray-700", "text-gray-600 dark:text-gray-400")
    };
}
