@model IEnumerable<TeknikServis.Domain.Entities.Service.ServiceRecord>
@{
    var dealers = ViewBag.Dealers as IEnumerable<TeknikServis.Domain.Entities.Dealer.Dealer> ?? Enumerable.Empty<TeknikServis.Domain.Entities.Dealer.Dealer>();
    int? selectedDealerId = ViewBag.SelectedDealerId;
}

<div class="flex flex-col gap-5">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-xl font-semibold text-gray-900 dark:text-white">Bayiden Gelen / Teslim Bekleyen</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">Bu cihazlar bayiler tarafından kaydedildi — siz teslim alınca ana listeye geçer.</p>
        </div>
        <div class="flex items-center gap-2">
            <form method="get" class="flex items-center gap-2">
                <select name="dealerId" onchange="this.form.submit()"
                        class="px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">— Tüm Bayiler —</option>
                    @foreach (var d in dealers)
                    {
                        if (selectedDealerId == d.Id)
                        {
                            <option value="@d.Id" selected>@d.CompanyName</option>
                        }
                        else
                        {
                            <option value="@d.Id">@d.CompanyName</option>
                        }
                    }
                </select>
            </form>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 rounded-xl px-4 py-3 text-sm text-green-700 dark:text-green-400">@TempData["Success"]</div>
    }

    @* Durum özeti kartları *@
    <div class="grid grid-cols-3 gap-4">
        @{
            int cntRegistered = Model.Count(s => s.Status == TeknikServis.Domain.Enums.ServiceStatus.DealerRegistered);
            int cntInTransit = Model.Count(s => s.Status == TeknikServis.Domain.Enums.ServiceStatus.DealerInTransit);
            int cntBatch = Model.Count(s => s.Status == TeknikServis.Domain.Enums.ServiceStatus.BatchAcceptancePending);
        }
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 text-center">
            <div class="text-2xl font-bold text-gray-700 dark:text-gray-300">@cntRegistered</div>
            <div class="text-xs text-gray-400 mt-1">Kayıt Açıldı</div>
            <div class="mt-1 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400">Sevk Bekleniyor</div>
        </div>
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 text-center">
            <div class="text-2xl font-bold text-gray-700 dark:text-gray-300">@cntInTransit</div>
            <div class="text-xs text-gray-400 mt-1">Transfer Aşamasında</div>
            <div class="mt-1 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-400">Kargo Yolda</div>
        </div>
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 text-center">
            <div class="text-2xl font-bold text-gray-700 dark:text-gray-300">@cntBatch</div>
            <div class="text-xs text-gray-400 mt-1">Toplu Kabul Bekliyor</div>
            <div class="mt-1 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-orange-100 dark:bg-orange-900/40 text-orange-700 dark:text-orange-400">Eşleme Bekliyor</div>
        </div>
    </div>

    @* Cihaz listesi *@
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
        @if (!Model.Any())
        {
            <div class="text-center py-12 text-gray-400 dark:text-gray-500 text-sm">Teslim bekleyen bayi cihazı bulunmuyor</div>
        }
        else
        {
            <table class="w-full text-sm">
                <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                    <tr>
                        <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Servis No</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Cihaz</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Müşteri / Bayi</th>
                        <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Durum</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Kargo</th>
                        <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Kayıt Tarihi</th>
                        <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">İşlem</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                    @foreach (var s in Model)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                            <td class="px-5 py-3">
                                <a href="@Url.Action("Detail","Service", new{id=s.Id})" class="font-mono text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline">@s.RecordNumber</a>
                            </td>
                            <td class="px-4 py-3">
                                <div class="font-medium text-gray-800 dark:text-gray-200">@s.DeviceModel?.Brand?.Name @s.DeviceModel?.Name</div>
                                @if (!string.IsNullOrEmpty(s.Imei1))
                                {
                                    <div class="text-xs font-mono text-gray-400">IMEI: @s.Imei1</div>
                                }
                            </td>
                            <td class="px-4 py-3">
                                <div class="text-gray-700 dark:text-gray-300">@s.Customer?.FirstName @s.Customer?.LastName</div>
                                @if (s.DealerIsContactPerson)
                                {
                                    <div class="text-xs text-purple-500 dark:text-purple-400">Bayi iletişim kişisi</div>
                                }
                                else
                                {
                                    <div class="text-xs text-gray-400">Müşteri ile doğrudan iletişim</div>
                                }
                            </td>
                            <td class="px-4 py-3 text-center">
                                @if (s.Status == TeknikServis.Domain.Enums.ServiceStatus.DealerRegistered)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400">Kayıt Açıldı</span>
                                }
                                else if (s.Status == TeknikServis.Domain.Enums.ServiceStatus.DealerInTransit)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-400">Kargo Yolda</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-orange-100 dark:bg-orange-900/40 text-orange-700 dark:text-orange-400">Eşleme Bekliyor</span>
                                }
                            </td>
                            <td class="px-4 py-3">
                                @if (!string.IsNullOrEmpty(s.InboundCargoTrackingNumber))
                                {
                                    <div class="font-mono text-xs text-gray-600 dark:text-gray-400">@s.InboundCargoCompany</div>
                                    <div class="font-mono text-xs text-gray-500 dark:text-gray-500">@s.InboundCargoTrackingNumber</div>
                                }
                                else
                                {
                                    <span class="text-xs text-gray-400">—</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-center text-xs text-gray-500 dark:text-gray-400">@s.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="px-4 py-3 text-right">
                                <form method="post" action="@Url.Action("AcceptFromDealer","Service")" class="inline"
                                      onsubmit="return confirm('Bu cihazı teslim aldığınızı onaylıyor musunuz?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@s.Id"/>
                                    <button type="submit"
                                            class="px-3 py-1 text-xs bg-green-50 dark:bg-green-900/20 text-green-700 dark:text-green-400 border border-green-200 dark:border-green-700 rounded-lg hover:bg-green-100 transition-colors font-medium">
                                        Teslim Al
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
