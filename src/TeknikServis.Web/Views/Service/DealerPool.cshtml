@model IEnumerable<TeknikServis.Domain.Entities.Service.ServiceRecord>
@{
    var dealers = ViewBag.Dealers as IEnumerable<TeknikServis.Domain.Entities.Dealer.Dealer> ?? Enumerable.Empty<TeknikServis.Domain.Entities.Dealer.Dealer>();
    int? selectedDealerId = ViewBag.SelectedDealerId;
    var poolRecords = Model.Where(s => s.Status == TeknikServis.Domain.Enums.ServiceStatus.DealerPool).ToList();
    var holdRecords = Model.Where(s => s.Status == TeknikServis.Domain.Enums.ServiceStatus.DealerCreditHold).ToList();
}

<div class="flex flex-col gap-5">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-xl font-semibold text-gray-900 dark:text-white">Bayi Sevkiyat Havuzu</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">Tamamlanan bayi cihazları toplu sevkiyat bekliyor.</p>
        </div>
        <form method="get" class="flex items-center gap-2">
            <select name="dealerId" onchange="this.form.submit()"
                    class="px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="">— Tüm Bayiler —</option>
                @foreach (var d in dealers)
                {
                    if (selectedDealerId == d.Id)
                    {
                        <option value="@d.Id" selected>@d.CompanyName</option>
                    }
                    else
                    {
                        <option value="@d.Id">@d.CompanyName</option>
                    }
                }
            </select>
        </form>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 rounded-xl px-4 py-3 text-sm text-green-700 dark:text-green-400">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700 rounded-xl px-4 py-3 text-sm text-red-700 dark:text-red-400">@TempData["Error"]</div>
    }

    @* Cari limit bekleyenler *@
    @if (holdRecords.Any())
    {
        <div class="bg-red-50 dark:bg-red-900/10 border border-red-200 dark:border-red-700 rounded-xl overflow-hidden">
            <div class="px-5 py-3 border-b border-red-200 dark:border-red-700 flex items-center gap-2">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 dark:bg-red-900/40 text-red-700 dark:text-red-400">Cari Limit Engeli</span>
                <span class="text-sm text-red-600 dark:text-red-400 font-medium">@holdRecords.Count cihaz bekliyor — Ödeme alınırsa serbest bırakılabilir</span>
            </div>
            <table class="w-full text-sm">
                <tbody class="divide-y divide-red-100 dark:divide-red-800">
                    @foreach (var s in holdRecords)
                    {
                        <tr class="hover:bg-red-50/50 dark:hover:bg-red-900/10">
                            <td class="px-5 py-3">
                                <a href="@Url.Action("Detail","Service", new{id=s.Id})" class="font-mono text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline">@s.RecordNumber</a>
                            </td>
                            <td class="px-4 py-3 text-gray-700 dark:text-gray-300">@s.DeviceModel?.Brand?.Name @s.DeviceModel?.Name</td>
                            <td class="px-4 py-3 text-gray-600 dark:text-gray-400">@s.FinalPrice?.ToString("N2") TL</td>
                            <td class="px-4 py-3 text-xs text-red-500">@s.DealerCreditHoldAt?.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="px-4 py-3 text-right">
                                <form method="post" action="@Url.Action("MoveToDealerPool","Service")" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@s.Id"/>
                                    <button type="submit" class="px-3 py-1 text-xs border border-gray-200 dark:border-gray-600 text-gray-600 dark:text-gray-400 rounded-lg hover:bg-gray-50 transition-colors">
                                        Serbest Bırak
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* Sevkiyat havuzu *@
    @if (!poolRecords.Any())
    {
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl text-center py-12 text-gray-400 dark:text-gray-500 text-sm">
            Sevkiyat bekleyen cihaz bulunmuyor
        </div>
    }
    else
    {
        @* Bayi bazında grupla ve sevkiyat formu göster *@
        @foreach (var dealerGroup in poolRecords.GroupBy(s => s.DealerId))
        {
            var groupDealer = dealers.FirstOrDefault(d => d.Id == dealerGroup.Key);
            <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
                <div class="px-5 py-3 bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
                    <div>
                        <span class="font-medium text-gray-800 dark:text-gray-200">@(groupDealer?.CompanyName ?? $"Bayi #{dealerGroup.Key}")</span>
                        <span class="ml-2 text-xs text-gray-400">@dealerGroup.Count() cihaz</span>
                        <span class="ml-2 text-xs font-medium text-green-600 dark:text-green-400">
                            Toplam: @dealerGroup.Sum(s => s.FinalPrice ?? 0).ToString("N2") TL
                        </span>
                    </div>
                </div>

                @* Toplu sevkiyat formu *@
                <form method="post" action="@Url.Action("ShipToDealer","Service")" class="px-5 py-3 bg-blue-50/50 dark:bg-blue-900/10 border-b border-gray-200 dark:border-gray-700 flex flex-wrap items-end gap-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="dealerId" value="@dealerGroup.Key"/>
                    @foreach (var s in dealerGroup)
                    {
                        <input type="hidden" name="recordIds" value="@s.Id"/>
                    }
                    <div>
                        <label class="block text-xs text-gray-500 mb-1">Kargo Firması <span class="text-red-500">*</span></label>
                        <input type="text" name="cargoCompany" required placeholder="MNG, Aras, Yurtiçi..."
                               class="px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 w-40"/>
                    </div>
                    <div>
                        <label class="block text-xs text-gray-500 mb-1">Takip Numarası</label>
                        <input type="text" name="cargoTracking" placeholder="opsiyonel"
                               class="px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 w-48"/>
                    </div>
                    <button type="submit"
                            class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors whitespace-nowrap">
                        Tümünü Sevk Et
                    </button>
                </form>

                <table class="w-full text-sm">
                    <thead class="border-b border-gray-100 dark:border-gray-700">
                        <tr>
                            <th class="text-left px-5 py-2 text-xs font-semibold text-gray-500 dark:text-gray-400">Servis No</th>
                            <th class="text-left px-4 py-2 text-xs font-semibold text-gray-500 dark:text-gray-400">Cihaz</th>
                            <th class="text-left px-4 py-2 text-xs font-semibold text-gray-500 dark:text-gray-400">Müşteri</th>
                            <th class="text-right px-4 py-2 text-xs font-semibold text-gray-500 dark:text-gray-400">Tutar</th>
                            <th class="text-center px-4 py-2 text-xs font-semibold text-gray-500 dark:text-gray-400">Havuza Giriş</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                        @foreach (var s in dealerGroup)
                        {
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30">
                                <td class="px-5 py-2">
                                    <a href="@Url.Action("Detail","Service", new{id=s.Id})" class="font-mono text-xs text-blue-600 dark:text-blue-400 hover:underline">@s.RecordNumber</a>
                                </td>
                                <td class="px-4 py-2 text-gray-700 dark:text-gray-300">@s.DeviceModel?.Brand?.Name @s.DeviceModel?.Name</td>
                                <td class="px-4 py-2 text-gray-600 dark:text-gray-400">@s.Customer?.FirstName @s.Customer?.LastName</td>
                                <td class="px-4 py-2 text-right font-medium text-gray-800 dark:text-gray-200">@(s.FinalPrice?.ToString("N2") ?? "—") TL</td>
                                <td class="px-4 py-2 text-center text-xs text-gray-500">@s.EnteredDealerPoolAt?.ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>
