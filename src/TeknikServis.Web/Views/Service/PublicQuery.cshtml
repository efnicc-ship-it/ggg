@model TeknikServis.Application.Features.Service.Queries.GetServiceRecordDetail.ServiceRecordDetailDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr" class="h-full">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="robots" content="noindex, nofollow"/>
    <title>Servis Takip — @Model.RecordNumber</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: { extend: { fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] } } }
        };
    </script>
</head>
<body class="min-h-full bg-gradient-to-br from-slate-100 to-blue-50 flex items-center justify-center p-4">

    <div class="w-full max-w-lg">

        {{!-- Header --}}
        <div class="text-center mb-6">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-blue-600 shadow-lg mb-4">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
            </div>
            <h1 class="text-xl font-bold text-slate-800">Servis Kaydınız</h1>
            <p class="text-sm text-slate-500 mt-1">Cihazınızın güncel durumunu aşağıda görebilirsiniz.</p>
        </div>

        {{!-- Card --}}
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">

            {{!-- Record header --}}
            <div class="p-5 border-b border-slate-100">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs text-slate-400 font-medium uppercase tracking-wide">Servis No</p>
                        <p class="text-lg font-bold text-slate-800 font-mono">@Model.RecordNumber</p>
                    </div>
                    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-sm font-semibold @Model.StatusColor">
                        @Model.StatusDisplay
                    </span>
                </div>
            </div>

            {{!-- Device info --}}
            <div class="p-5 border-b border-slate-100">
                <p class="text-xs text-slate-400 font-medium uppercase tracking-wide mb-3">Cihaz</p>
                <div class="flex items-start gap-3">
                    <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="font-semibold text-slate-800">@Model.DeviceBrand @Model.DeviceModel</p>
                        @if (!string.IsNullOrEmpty(Model.DeviceVariant))
                        {
                            <p class="text-sm text-slate-500">@Model.DeviceVariant</p>
                        }
                    </div>
                </div>
                <div class="mt-3">
                    <p class="text-xs text-slate-400 mb-1">Bildirilen Arıza</p>
                    <p class="text-sm text-slate-700">@Model.FaultDescription</p>
                </div>
            </div>

            {{!-- Status timeline --}}
            @if (Model.StatusHistory.Any())
            {
                <div class="p-5 border-b border-slate-100">
                    <p class="text-xs text-slate-400 font-medium uppercase tracking-wide mb-3">Durum Geçmişi</p>
                    <div class="space-y-3">
                        @foreach (var h in Model.StatusHistory.OrderByDescending(x => x.ChangedAt).Take(5))
                        {
                            <div class="flex gap-3">
                                <div class="w-2 h-2 rounded-full bg-blue-500 mt-1.5 flex-shrink-0"></div>
                                <div class="flex-1">
                                    <p class="text-sm font-medium text-slate-700">@GetStatusDisplay(h.NewStatus)</p>
                                    <p class="text-xs text-slate-400">@h.ChangedAt.ToString("dd MMMM yyyy HH:mm")</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            {{!-- Price approval section --}}
            @if (Model.Status == TeknikServis.Domain.Enums.ServiceStatus.AwaitingApproval && Model.QuotedPrice.HasValue && Model.PriceApproved == null)
            {
                <div class="p-5 bg-amber-50 border-b border-amber-100">
                    <p class="text-sm font-semibold text-amber-800 mb-1">Fiyat Onayı Bekleniyor</p>
                    <p class="text-xs text-amber-600 mb-4">
                        Cihazınızın onarım tahmini fiyatı <strong class="text-amber-800">@Model.QuotedPrice.Value.ToString("N2") ₺</strong> olarak belirlenmiştir.
                        Devam etmek için onaylamanız gerekmektedir.
                    </p>
                    <div class="flex gap-3">
                        <form method="post" action="@Url.Action("ApprovePrice","Service", new{token=Model.ApprovalToken})" class="flex-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="approved" value="true"/>
                            <button type="submit" class="w-full py-2.5 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold rounded-xl transition-colors">
                                Onaylıyorum
                            </button>
                        </form>
                        <form method="post" action="@Url.Action("ApprovePrice","Service", new{token=Model.ApprovalToken})" class="flex-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="approved" value="false"/>
                            <button type="submit" class="w-full py-2.5 border-2 border-red-300 text-red-600 hover:bg-red-50 text-sm font-semibold rounded-xl transition-colors">
                                Reddediyorum
                            </button>
                        </form>
                    </div>
                </div>
            }
            else if (Model.PriceApproved.HasValue)
            {
                <div class="p-5 @(Model.PriceApproved.Value ? "bg-green-50 border-b border-green-100" : "bg-red-50 border-b border-red-100")">
                    <p class="text-sm font-semibold @(Model.PriceApproved.Value ? "text-green-700" : "text-red-700")">
                        @(Model.PriceApproved.Value ? "Fiyat Onaylandı" : "Fiyat Reddedildi")
                    </p>
                    @if (Model.QuotedPrice.HasValue)
                    {
                        <p class="text-xs @(Model.PriceApproved.Value ? "text-green-600" : "text-red-600") mt-1">
                            @Model.QuotedPrice.Value.ToString("N2") ₺
                        </p>
                    }
                </div>
            }

            {{!-- Dates --}}
            <div class="p-5 bg-slate-50">
                <div class="flex justify-between text-sm">
                    <div>
                        <p class="text-xs text-slate-400">Kayıt Tarihi</p>
                        <p class="font-medium text-slate-700">@Model.CreatedAt.ToString("dd.MM.yyyy")</p>
                    </div>
                    @if (Model.DeliveredAt.HasValue)
                    {
                        <div class="text-right">
                            <p class="text-xs text-slate-400">Teslim Tarihi</p>
                            <p class="font-medium text-slate-700">@Model.DeliveredAt.Value.ToString("dd.MM.yyyy")</p>
                        </div>
                    }
                    else
                    {
                        <div class="text-right">
                            <p class="text-xs text-slate-400">Bekleme Süresi</p>
                            <p class="font-medium text-slate-700">@Model.DaysOpen gün</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        {{!-- Notes for customer (non-internal only) --}}
        @{
            var publicNotes = Model.Notes.Where(n => !n.IsInternal).OrderByDescending(n => n.CreatedAt).ToList();
        }
        @if (publicNotes.Any())
        {
            <div class="bg-white rounded-2xl shadow border border-slate-200 p-5 mt-4">
                <p class="text-xs text-slate-400 font-medium uppercase tracking-wide mb-3">Servis Notları</p>
                <div class="space-y-3">
                    @foreach (var note in publicNotes)
                    {
                        <div class="p-3 bg-slate-50 rounded-xl">
                            <p class="text-sm text-slate-700">@note.Content</p>
                            <p class="text-xs text-slate-400 mt-1">@note.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                        </div>
                    }
                </div>
            </div>
        }

        <p class="text-center text-xs text-slate-400 mt-6">
            Bu sayfa kişisel olup yalnızca size özeldir. Lütfen paylaşmayın.
        </p>

    </div>
</body>
</html>

@functions {
    static string GetStatusDisplay(TeknikServis.Domain.Enums.ServiceStatus s) => s switch
    {
        TeknikServis.Domain.Enums.ServiceStatus.Received => "Teslim Alındı",
        TeknikServis.Domain.Enums.ServiceStatus.Diagnosing => "Arıza Tespiti",
        TeknikServis.Domain.Enums.ServiceStatus.AwaitingParts => "Parça Bekleniyor",
        TeknikServis.Domain.Enums.ServiceStatus.InRepair => "Onarımda",
        TeknikServis.Domain.Enums.ServiceStatus.AwaitingApproval => "Onay Bekleniyor",
        TeknikServis.Domain.Enums.ServiceStatus.Ready => "Hazır — Teslim Alabilirsiniz",
        TeknikServis.Domain.Enums.ServiceStatus.Delivered => "Teslim Edildi",
        TeknikServis.Domain.Enums.ServiceStatus.Cancelled => "İptal Edildi",
        TeknikServis.Domain.Enums.ServiceStatus.Unrepairable => "Onarım Mümkün Değil",
        TeknikServis.Domain.Enums.ServiceStatus.ReturnedUnrepaired => "İade Edildi",
        _ => s.ToString()
    };
}
