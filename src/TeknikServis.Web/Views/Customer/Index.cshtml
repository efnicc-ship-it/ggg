@model TeknikServis.Application.Features.Customer.Queries.GetCustomers.GetCustomersResult

@{
    var q = ViewBag.Q as string;
    var blacklisted = ViewBag.Blacklisted as bool?;
    int currentPage = Model.Page;
    int totalPages = Model.TotalPages;
}

<div class="flex flex-col gap-5">

    {{!-- Header --}}
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-xl font-semibold text-gray-900 dark:text-white">Müşteriler</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">
                Toplam <span class="font-medium text-gray-700 dark:text-gray-300">@Model.TotalCount</span> müşteri
            </p>
        </div>
        <a href="@Url.Action("Create","Customer")"
           class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
            </svg>
            Yeni Müşteri
        </a>
    </div>

    {{!-- Filters --}}
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4">
        <form method="get" action="@Url.Action("Index","Customer")" class="flex flex-col sm:flex-row gap-3">
            <div class="flex-1 relative">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0"/>
                </svg>
                <input type="text" name="q" value="@q" placeholder="Ad, telefon veya e-posta ara..."
                       class="w-full pl-9 pr-4 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
            </div>
            <select name="blacklisted"
                    class="px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="">Tüm Müşteriler</option>
                <option value="false" selected="@(blacklisted == false ? "selected" : null)">Normal</option>
                <option value="true" selected="@(blacklisted == true ? "selected" : null)">Kara Listede</option>
            </select>
            <button type="submit"
                    class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">
                Filtrele
            </button>
        </form>
    </div>

    {{!-- Table --}}
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
        @if (!Model.Items.Any())
        {
            <div class="flex flex-col items-center justify-center py-16 text-center">
                <svg class="w-12 h-12 text-gray-300 dark:text-gray-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
                <p class="text-gray-500 dark:text-gray-400 font-medium">Müşteri bulunamadı</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                        <tr>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Müşteri</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Telefon</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Şehir</th>
                            <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Puan</th>
                            <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Durum</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Kayıt</th>
                            <th class="px-4 py-3"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                        @foreach (var item in Model.Items)
                        {
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors @(item.IsBlacklisted ? "bg-red-50/50 dark:bg-red-900/5" : "")">
                                <td class="px-4 py-3">
                                    <div class="flex items-center gap-2">
                                        <div class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center flex-shrink-0">
                                            <span class="text-xs font-semibold text-blue-700 dark:text-blue-300">
                                                @item.FullName.Substring(0, 1).ToUpper()
                                            </span>
                                        </div>
                                        <div>
                                            <p class="font-medium text-gray-900 dark:text-white">@item.FullName</p>
                                            @if (item.IsBlacklisted)
                                            {
                                                <span class="text-xs text-red-600 dark:text-red-400">Kara listede</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="px-4 py-3">
                                    <div class="text-gray-700 dark:text-gray-300">@item.Phone</div>
                                    @if (item.PhoneVerified)
                                    {
                                        <div class="text-xs text-green-600 dark:text-green-400">Doğrulandı</div>
                                    }
                                </td>
                                <td class="px-4 py-3 text-gray-500 dark:text-gray-400">@(item.City ?? "—")</td>
                                <td class="px-4 py-3 text-center">
                                    @if (item.RatingCount > 0)
                                    {
                                        <div class="flex items-center justify-center gap-1">
                                            <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                            </svg>
                                            <span class="text-xs font-medium text-gray-700 dark:text-gray-300">@item.AverageRating.ToString("F1")</span>
                                            <span class="text-xs text-gray-400">(@item.RatingCount)</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-gray-300 dark:text-gray-600 text-xs">—</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-center">
                                    @if (item.IsBlacklisted)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-400">Engelli</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-400">Aktif</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-xs text-gray-400 dark:text-gray-500">@item.CreatedAt.ToString("dd.MM.yyyy")</td>
                                <td class="px-4 py-3 text-right">
                                    <a href="@Url.Action("Detail","Customer", new{id=item.Id})"
                                       class="text-blue-600 dark:text-blue-400 hover:underline text-sm font-medium">Detay</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="flex items-center justify-between px-4 py-3 border-t border-gray-100 dark:border-gray-700">
                    <p class="text-sm text-gray-500 dark:text-gray-400">
                        @((currentPage - 1) * Model.PageSize + 1)–@(Math.Min(currentPage * Model.PageSize, Model.TotalCount)) / @Model.TotalCount
                    </p>
                    <div class="flex gap-1">
                        @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                        {
                            <a href="@Url.Action("Index","Customer", new{q, blacklisted, page=p})"
                               class="px-3 py-1.5 text-sm border rounded-lg transition-colors @(p == currentPage ? "bg-blue-600 border-blue-600 text-white" : "border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300")">
                                @p
                            </a>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
