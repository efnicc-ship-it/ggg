@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLower() ?? "";
    bool Active(string c) => ctrl == c.ToLower();
    string NavCls(string c) => Active(c)
        ? "flex items-center gap-3 px-3 py-2 rounded-lg bg-primary-50 dark:bg-primary-900/30 text-primary font-medium text-sm"
        : "flex items-center gap-3 px-3 py-2 rounded-lg text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-gray-100 text-sm transition-colors";
}

<!-- Dashboard -->
<a asp-controller="Home" asp-action="Index" class="@NavCls("Home")">
    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
    </svg>
    <span x-show="sidebarOpen" class="truncate">Panel</span>
</a>

<!-- SERVIS -->
<div class="pt-3 pb-1 px-3" x-show="sidebarOpen">
    <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Servis</p>
</div>
<a asp-controller="Service" asp-action="Index" class="@NavCls("Service")">
    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
    </svg>
    <span x-show="sidebarOpen" class="truncate">Servis Kayıtları</span>
</a>
<a asp-controller="Appointment" asp-action="Index" class="@NavCls("Appointment")">
    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
    </svg>
    <span x-show="sidebarOpen" class="truncate">Randevular</span>
</a>

