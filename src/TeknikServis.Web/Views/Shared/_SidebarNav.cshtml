</a>

<!-- KATALOG / YÖNETİM -->
<div class="pt-3 pb-1 px-3" x-show="sidebarOpen">
    <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Katalog</p>
</div>
<a asp-controller="DeviceCatalog" asp-action="Index" class="@NavCls("DeviceCatalog")">
    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
    </svg>
    <span x-show="sidebarOpen" class="truncate">Cihaz Kataloğu</span>
</a>

<!-- RAPORLAR / YÖNETİM (admin only) -->
@if (User.IsInRole("SuperAdmin") || User.IsInRole("TenantOwner") || User.IsInRole("GeneralManager") || User.IsInRole("BranchManager"))
{
    <div class="pt-3 pb-1 px-3" x-show="sidebarOpen">
        <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Yönetim</p>
    </div>
    <a asp-controller="Report" asp-action="Index" class="@NavCls("Report")">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <span x-show="sidebarOpen" class="truncate">Raporlar</span>
    </a>
    <a asp-controller="Admin" asp-action="Index" class="@NavCls("Admin")">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <span x-show="sidebarOpen" class="truncate">Sistem Ayarları</span>
    </a>
    <a asp-controller="AiAlert" asp-action="Index" class="@NavCls("AiAlert")">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        <span x-show="sidebarOpen" class="truncate">Ensar AI</span>
    </a>
}
