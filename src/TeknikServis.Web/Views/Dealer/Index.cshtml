@model IEnumerable<TeknikServis.Domain.Entities.Dealer.Dealer>

@{
    int page = ViewBag.Page ?? 1;
    int total = ViewBag.TotalCount ?? 0;
    int totalPages = ViewBag.TotalPages ?? 1;
    string? q = ViewBag.Q as string;
}

<div class="flex flex-col gap-5">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-xl font-semibold text-gray-900 dark:text-white">Bayi Yönetimi</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">Toplam <span class="font-medium text-gray-700 dark:text-gray-300">@total</span> bayi</p>
        </div>
        <a href="@Url.Action("Create","Dealer")"
           class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Yeni Bayi
        </a>
    </div>

    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4">
        <form method="get" class="flex gap-3">
            <div class="flex-1 relative">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0"/>
                </svg>
                <input type="text" name="q" value="@q" placeholder="Firma adı, yetkili veya telefon ara..."
                       class="w-full pl-9 pr-4 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
            </div>
            <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">Ara</button>
        </form>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 rounded-xl px-4 py-3 text-sm text-green-700 dark:text-green-400">
            @TempData["Success"]
        </div>
    }

    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
        @if (!Model.Any())
        {
            <div class="text-center py-16 text-gray-400 dark:text-gray-500 text-sm">Bayi bulunamadı</div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                        <tr>
                            <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Firma / Yetkili</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">İletişim</th>
                            <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Kredi Limiti</th>
                            <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Cari Bakiye</th>
                            <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Durum</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                        @foreach (var dealer in Model)
                        {
                            var balanceNeg = dealer.CurrentBalance < 0;
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                                <td class="px-5 py-3">
                                    <div class="font-medium text-gray-800 dark:text-gray-200">@dealer.CompanyName</div>
                                    <div class="text-xs text-gray-400">@dealer.ContactName</div>
                                </td>
                                <td class="px-4 py-3">
                                    <div class="text-gray-700 dark:text-gray-300">@dealer.Phone</div>
                                    @if (!string.IsNullOrEmpty(dealer.Email))
                                    {
                                        <div class="text-xs text-gray-400">@dealer.Email</div>
                                    }
                                </td>
                                <td class="px-4 py-3 text-right text-gray-700 dark:text-gray-300">@dealer.CreditLimit.ToString("N2") ₺</td>
                                <td class="px-4 py-3 text-right font-medium @(balanceNeg ? "text-red-600 dark:text-red-400" : "text-green-600 dark:text-green-400")">
                                    @(dealer.CurrentBalance >= 0 ? "+" : "")@dealer.CurrentBalance.ToString("N2") ₺
                                </td>
                                <td class="px-4 py-3 text-center">
                                    @if (dealer.IsActive)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-400">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 dark:bg-red-900/40 text-red-700 dark:text-red-400">Pasif</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="flex justify-end gap-1 px-4 py-3 border-t border-gray-100 dark:border-gray-700">
                    @for (int p = Math.Max(1, page - 2); p <= Math.Min(totalPages, page + 2); p++)
                    {
                        <a href="@Url.Action("Index","Dealer", new{q, page=p})"
                           class="px-3 py-1.5 text-sm border rounded-lg @(p == page ? "bg-blue-600 border-blue-600 text-white" : "border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300")">@p</a>
                    }
                </div>
            }
        }
    </div>
</div>
