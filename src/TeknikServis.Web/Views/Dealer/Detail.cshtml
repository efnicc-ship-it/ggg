@model TeknikServis.Domain.Entities.Dealer.Dealer
@{
    var records = ViewBag.Records as IEnumerable<TeknikServis.Domain.Entities.Service.ServiceRecord> ?? Enumerable.Empty<TeknikServis.Domain.Entities.Service.ServiceRecord>();
    var batches = ViewBag.Batches as IEnumerable<TeknikServis.Domain.Entities.Dealer.DealerBatchShipment> ?? Enumerable.Empty<TeknikServis.Domain.Entities.Dealer.DealerBatchShipment>();
    decimal creditUsage = Model.CreditLimit > 0 ? Math.Min((Math.Abs(Model.CurrentBalance) / Model.CreditLimit) * 100, 100) : 0;
}

<div class="flex flex-col gap-5">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <nav class="flex items-center gap-1.5 text-xs text-gray-400 mb-1">
                <a href="@Url.Action("Index","Dealer")" class="hover:text-blue-600 dark:hover:text-blue-400">Bayiler</a>
                <span>/</span>
                <span class="text-gray-600 dark:text-gray-300">@Model.CompanyName</span>
            </nav>
            <h1 class="text-xl font-semibold text-gray-900 dark:text-white">@Model.CompanyName</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">@Model.ContactName · @Model.Phone</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="@Url.Action("PortalRegister","Dealer", new{dealerId=Model.Id})"
               class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">
                Bayi Adına Kayıt Aç
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 rounded-xl px-4 py-3 text-sm text-green-700 dark:text-green-400">@TempData["Success"]</div>
    }

    @* Özet kartlar *@
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4">
            <div class="text-xs text-gray-400 mb-1">Cari Bakiye</div>
            <div class="text-xl font-bold @(Model.CurrentBalance >= 0 ? "text-green-600 dark:text-green-400" : "text-red-600 dark:text-red-400")">
                @Model.CurrentBalance.ToString("N2") TL
            </div>
            <div class="text-xs text-gray-400 mt-1">@(Model.CurrentBalance >= 0 ? "Alacaklı" : "Borçlu")</div>
        </div>
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4">
            <div class="text-xs text-gray-400 mb-1">Kredi Limiti</div>
            <div class="text-xl font-bold text-gray-800 dark:text-gray-200">@Model.CreditLimit.ToString("N2") TL</div>
            @if (Model.CreditLimit > 0)
            {
                <div class="mt-2 h-1.5 bg-gray-100 dark:bg-gray-700 rounded-full overflow-hidden">
                    <div class="h-full @(creditUsage > 80 ? "bg-red-500" : creditUsage > 50 ? "bg-amber-400" : "bg-green-500") rounded-full transition-all"
                         style="width:@creditUsage.ToString("0")%"></div>
                </div>
                <div class="text-xs text-gray-400 mt-1">@creditUsage.ToString("0")% kullanılıyor</div>
            }
        </div>
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4">
            <div class="text-xs text-gray-400 mb-1">Oto Onay Limiti</div>
            @if (Model.AutoApprovalLimit.HasValue)
            {
                <div class="text-xl font-bold text-purple-600 dark:text-purple-400">@Model.AutoApprovalLimit.Value.ToString("N2") TL</div>
                <div class="text-xs text-gray-400 mt-1">Bu limite kadar otomatik onay</div>
            }
            else
            {
                <div class="text-xl font-bold text-gray-400">Devre Dışı</div>
                <div class="text-xs text-gray-400 mt-1">Tüm işlemler onay bekler</div>
            }
        </div>
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4">
            <div class="text-xs text-gray-400 mb-1">İletişim Tercihi</div>
            @if (Model.DefaultDealerIsContact)
            {
                <div class="text-base font-bold text-purple-600 dark:text-purple-400">Bayi İletişim Kişisi</div>
                <div class="text-xs text-gray-400 mt-1">Onay ve bildirimler bayiye</div>
            }
            else
            {
                <div class="text-base font-bold text-blue-600 dark:text-blue-400">Müşteri ile Doğrudan</div>
                <div class="text-xs text-gray-400 mt-1">Bayi araya girmiyor</div>
            }
        </div>
    </div>

    @* Ayarlar *@
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-5">
        <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-4">Bayi Ayarları</h2>
        <form method="post" action="@Url.Action("Edit","Dealer")" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id"/>
            <div>
                <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Kredi Limiti (TL)</label>
                <input type="number" name="creditLimit" value="@Model.CreditLimit" step="100" min="0"
                       class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Oto Onay Limiti (TL, boş = devre dışı)</label>
                <input type="number" name="autoApprovalLimit" value="@Model.AutoApprovalLimit" step="50" min="0" placeholder="0 = devre dışı"
                       class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                <p class="text-xs text-gray-400 mt-0.5">Bu tutarın altındaki servisler otomatik onaylanır</p>
            </div>
            <div class="flex flex-col gap-2">
                <label class="flex items-center gap-2 cursor-pointer mt-5">
                    <input type="checkbox" name="defaultDealerIsContact" value="true" @(Model.DefaultDealerIsContact ? "checked" : "")
                           class="w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500"/>
                    <span class="text-sm text-gray-700 dark:text-gray-300">Bayi iletişim kişisi (varsayılan)</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" name="showMaskedStatusOnly" value="true" @(Model.ShowMaskedStatusOnly ? "checked" : "")
                           class="w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500"/>
                    <span class="text-sm text-gray-700 dark:text-gray-300">Bayi panelinde maskelenmiş durum göster</span>
                </label>
            </div>
            <div class="flex items-end">
                <button type="submit" class="w-full px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">
                    Kaydet
                </button>
            </div>
        </form>
    </div>

    @* Son servis kayıtları *@
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
        <div class="px-5 py-3 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
            <span class="text-sm font-semibold text-gray-700 dark:text-gray-300">Son Servis Kayıtları</span>
            <a href="@Url.Action("DealerIncoming","Service", new{dealerId=Model.Id})"
               class="text-xs text-blue-600 dark:text-blue-400 hover:underline">Teslim Bekleyenler →</a>
        </div>
        @if (!records.Any())
        {
            <div class="text-center py-8 text-gray-400 text-sm">Kayıt bulunamadı</div>
        }
        else
        {
            <table class="w-full text-sm">
                <thead class="bg-gray-50 dark:bg-gray-700/50">
                    <tr>
                        <th class="text-left px-5 py-2 text-xs font-semibold text-gray-500 dark:text-gray-400">Servis No</th>
                        <th class="text-left px-4 py-2 text-xs font-semibold text-gray-500 dark:text-gray-400">Cihaz</th>
                        <th class="text-left px-4 py-2 text-xs font-semibold text-gray-500 dark:text-gray-400">Müşteri</th>
                        <th class="text-center px-4 py-2 text-xs font-semibold text-gray-500 dark:text-gray-400">Durum</th>
                        <th class="text-right px-4 py-2 text-xs font-semibold text-gray-500 dark:text-gray-400">Tutar</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                    @foreach (var r in records)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30">
                            <td class="px-5 py-2">
                                <a href="@Url.Action("Detail","Service", new{id=r.Id})" class="font-mono text-xs text-blue-600 dark:text-blue-400 hover:underline">@r.RecordNumber</a>
                            </td>
                            <td class="px-4 py-2 text-gray-700 dark:text-gray-300">@r.DeviceModel?.Brand?.Name @r.DeviceModel?.Name</td>
                            <td class="px-4 py-2 text-gray-600 dark:text-gray-400">@r.Customer?.FirstName @r.Customer?.LastName</td>
                            <td class="px-4 py-2 text-center">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300">@r.Status</span>
                            </td>
                            <td class="px-4 py-2 text-right text-gray-700 dark:text-gray-300">@(r.FinalPrice?.ToString("N2") ?? "—") TL</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
