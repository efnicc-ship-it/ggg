@{
    var dealer = ViewBag.Dealer as TeknikServis.Domain.Entities.Dealer.Dealer;
    var deviceTypes = ViewBag.DeviceTypes as IEnumerable<TeknikServis.Domain.Entities.Device.DeviceType> ?? Enumerable.Empty<TeknikServis.Domain.Entities.Device.DeviceType>();
    var customers = ViewBag.Customers as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="flex flex-col gap-5 max-w-2xl">

    <div>
        <nav class="flex items-center gap-1.5 text-xs text-gray-400 mb-1">
            <a href="@Url.Action("Index","Dealer")" class="hover:text-blue-600 dark:hover:text-blue-400">Bayiler</a>
            <span>/</span>
            <a href="@Url.Action("Detail","Dealer", new{id=dealer?.Id})" class="hover:text-blue-600 dark:hover:text-blue-400">@dealer?.CompanyName</a>
            <span>/</span>
            <span class="text-gray-600 dark:text-gray-300">Bayi Adına Kayıt Aç</span>
        </nav>
        <h1 class="text-xl font-semibold text-gray-900 dark:text-white">Bayi Adına Servis Kaydı</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">@dealer?.CompanyName bayisi için servis kaydı oluşturuluyor.</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700 rounded-xl px-4 py-3 text-sm text-red-700 dark:text-red-400">@TempData["Error"]</div>
    }

    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6">
        <form method="post" action="@Url.Action("PortalRegister","Dealer")" class="flex flex-col gap-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="dealerId" value="@dealer?.Id"/>

            @* Müşteri *@
            <div>
                <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Müşteri <span class="text-red-500">*</span></label>
                <select name="customerId" required
                        class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">— Müşteri Seç —</option>
                    @foreach (var c in customers)
                    {
                        <option value="@c.Id">@c.FullName (@c.Phone)</option>
                    }
                </select>
            </div>

            @* Cihaz *@
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Cihaz Türü <span class="text-red-500">*</span></label>
                    <select id="deviceType"
                            class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">— Tür Seç —</option>
                        @foreach (var t in deviceTypes)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Marka <span class="text-red-500">*</span></label>
                    <select id="deviceBrand" disabled
                            class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:opacity-50">
                        <option value="">— Önce Tür Seç —</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Model <span class="text-red-500">*</span></label>
                    <select name="deviceModelId" id="deviceModel" required disabled
                            class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:opacity-50">
                        <option value="">— Önce Marka Seç —</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Varyant</label>
                    <select name="deviceModelVariantId" id="deviceVariant" disabled
                            class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:opacity-50">
                        <option value="">— Varyant Yok —</option>
                    </select>
                </div>
            </div>

            @* Cihaz detayları *@
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">IMEI 1</label>
                    <input type="text" name="imei1" maxlength="20" placeholder="15 haneli IMEI"
                           class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">IMEI 2 / Seri No</label>
                    <input type="text" name="serialNumber" maxlength="30"
                           class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Renk</label>
                    <input type="text" name="deviceColor" placeholder="Örn: Siyah, Beyaz"
                           class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                </div>
            </div>

            @* Arıza *@
            <div>
                <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Arıza Açıklaması <span class="text-red-500">*</span></label>
                <textarea name="faultDescription" required rows="2" placeholder="Müşterinin ifade ettiği arıza..."
                          class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"></textarea>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">İç Not (müşteriye gösterilmez)</label>
                <textarea name="internalNotes" rows="2" placeholder="Bayiden gelen ek notlar..."
                          class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"></textarea>
            </div>

            @* Kargo bilgisi *@
            <div class="p-4 bg-gray-50 dark:bg-gray-700/30 rounded-lg">
                <div class="text-xs font-semibold text-gray-600 dark:text-gray-400 mb-3">Gelen Kargo Bilgisi (bayiden kargo geliyorsa)</div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Kargo Firması</label>
                        <input type="text" name="inboundCargoCompany" placeholder="MNG, Aras, Yurtiçi..."
                               class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                    </div>
                    <div>
                        <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Takip Numarası</label>
                        <input type="text" name="inboundCargoTrackingNumber"
                               class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                        <p class="text-xs text-gray-400 mt-0.5">Girildiyse durum "Kargo Yolda" olarak başlar</p>
                    </div>
                </div>
            </div>

            @* İletişim tercihi *@
            <div class="p-4 bg-purple-50 dark:bg-purple-900/10 border border-purple-200 dark:border-purple-800 rounded-lg">
                <div class="text-xs font-semibold text-purple-700 dark:text-purple-400 mb-2">İletişim Tercihi</div>
                <div class="flex flex-col gap-2">
                    <label class="flex items-start gap-3 cursor-pointer">
                        <input type="radio" name="dealerIsContactPerson" value="true"
                               @(dealer?.DefaultDealerIsContact == true ? "checked" : "")
                               class="mt-0.5 text-purple-600 focus:ring-purple-500"/>
                        <div>
                            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">Bayi iletişim kişisi</div>
                            <div class="text-xs text-gray-400">Onay ve bildirimler bayiye iletilir. Bayi kendi müşterisiyle iletişim kurar (karını ekleyebilir).</div>
                        </div>
                    </label>
                    <label class="flex items-start gap-3 cursor-pointer">
                        <input type="radio" name="dealerIsContactPerson" value="false"
                               @(dealer?.DefaultDealerIsContact == false ? "checked" : "")
                               class="mt-0.5 text-blue-600 focus:ring-blue-500"/>
                        <div>
                            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">Müşteri ile doğrudan iletişim</div>
                            <div class="text-xs text-gray-400">Servis merkezi müşteriyle doğrudan iletişim kurar. Bayi arada değil.</div>
                        </div>
                    </label>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
                <a href="@Url.Action("Detail","Dealer", new{id=dealer?.Id})"
                   class="px-4 py-2 text-sm text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                    İptal
                </a>
                <button type="submit" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">
                    Kaydı Oluştur
                </button>
            </div>
        </form>
    </div>
</div>

<script>
document.getElementById('deviceType').addEventListener('change', async function() {
    const typeId = this.value;
    const brandSelect = document.getElementById('deviceBrand');
    const modelSelect = document.getElementById('deviceModel');
    const variantSelect = document.getElementById('deviceVariant');

    brandSelect.innerHTML = '<option value="">Yükleniyor...</option>';
    brandSelect.disabled = true;
    modelSelect.innerHTML = '<option value="">— Önce Marka Seç —</option>';
    modelSelect.disabled = true;
    variantSelect.innerHTML = '<option value="">— Varyant Yok —</option>';
    variantSelect.disabled = true;

    if (!typeId) { brandSelect.innerHTML = '<option value="">— Önce Tür Seç —</option>'; return; }

    const res = await fetch(`/api/catalog/brands?typeId=${typeId}`);
    const brands = await res.json();
    brandSelect.innerHTML = '<option value="">— Marka Seç —</option>' + brands.map(b => `<option value="${b.id}">${b.name}</option>`).join('');
    brandSelect.disabled = false;
});

document.getElementById('deviceBrand').addEventListener('change', async function() {
    const brandId = this.value;
    const modelSelect = document.getElementById('deviceModel');
    const variantSelect = document.getElementById('deviceVariant');

    modelSelect.innerHTML = '<option value="">Yükleniyor...</option>';
    modelSelect.disabled = true;
    variantSelect.innerHTML = '<option value="">— Varyant Yok —</option>';
    variantSelect.disabled = true;

    if (!brandId) { modelSelect.innerHTML = '<option value="">— Önce Marka Seç —</option>'; return; }

    const res = await fetch(`/api/catalog/models?brandId=${brandId}`);
    const models = await res.json();
    modelSelect.innerHTML = '<option value="">— Model Seç —</option>' + models.map(m => `<option value="${m.id}" data-variants="${m.hasVariants}">${m.name}</option>`).join('');
    modelSelect.disabled = false;
});

document.getElementById('deviceModel').addEventListener('change', async function() {
    const modelId = this.value;
    const selected = this.options[this.selectedIndex];
    const hasVariants = selected?.dataset?.variants === 'True';
    const variantSelect = document.getElementById('deviceVariant');

    variantSelect.innerHTML = '<option value="">Yükleniyor...</option>';
    variantSelect.disabled = true;

    if (!modelId || !hasVariants) {
        variantSelect.innerHTML = '<option value="">— Varyant Yok —</option>';
        return;
    }

    const res = await fetch(`/api/catalog/variants?modelId=${modelId}`);
    const variants = await res.json();
    variantSelect.innerHTML = '<option value="">— Varyant Seç —</option>' + variants.map(v => `<option value="${v.id}">${v.variantName} (${v.modelCode})</option>`).join('');
    variantSelect.disabled = false;
});
</script>
