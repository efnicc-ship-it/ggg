@model IEnumerable<TeknikServis.Domain.Entities.Identity.UserRoleAssignment>

@{
    var userNames = ViewBag.Users as Dictionary<int, string> ?? new Dictionary<int, string>();
    var roleOptions = new[] { "SuperAdmin","TenantOwner","GeneralManager","RegionalManager","BranchManager","Technician","Reception","Dealer","ReadOnlyViewer" };
}

<div class="flex flex-col gap-5">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-xl font-semibold text-gray-900 dark:text-white">Kullanıcı Rol Yönetimi</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">Kullanıcılara rol atayın veya rollerini kaldırın</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 rounded-xl px-4 py-3 text-sm text-green-700 dark:text-green-400">
            @TempData["Success"]
        </div>
    }

    @* Rol Ata *@
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-5">
        <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-4">Yeni Rol Ata</h2>
        <form method="post" action="@Url.Action("AssignRole","Admin")">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                    <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Kullanıcı ID</label>
                    <input type="number" name="userId" required placeholder="Kullanıcı ID"
                           class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Rol</label>
                    <select name="roleName" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                        @foreach (var r in roleOptions)
                        {
                            <option value="@r">@r</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Bitiş Tarihi (opsiyonel)</label>
                    <input type="date" name="expiresAt"
                           class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                </div>
            </div>
            <div class="mt-3 flex justify-end">
                <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">Rol Ata</button>
            </div>
        </form>
    </div>

    @* Mevcut Rol Atamaları *@
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
        @if (!Model.Any())
        {
            <div class="text-center py-16 text-gray-400 dark:text-gray-500 text-sm">Rol ataması bulunamadı</div>
        }
        else
        {
            <table class="w-full text-sm">
                <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                    <tr>
                        <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Kullanıcı</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Rol</th>
                        <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Durum</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Bitiş</th>
                        <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">İşlem</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                    @foreach (var ra in Model)
                    {
                        var isExpired = ra.ExpiresAt.HasValue && ra.ExpiresAt < DateTime.UtcNow;
                        var userName = userNames.TryGetValue(ra.UserId, out var n) ? n : $"ID:{ra.UserId}";
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                            <td class="px-5 py-3 font-medium text-gray-800 dark:text-gray-200">@userName</td>
                            <td class="px-4 py-3">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400">@ra.RoleName</span>
                            </td>
                            <td class="px-4 py-3 text-center">
                                @if (!ra.IsActive || isExpired)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 dark:bg-red-900/40 text-red-700 dark:text-red-400">Pasif</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-400">Aktif</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-xs text-gray-500 dark:text-gray-400">
                                @(ra.ExpiresAt.HasValue ? ra.ExpiresAt.Value.ToString("dd.MM.yyyy") : "Kalıcı")
                            </td>
                            <td class="px-4 py-3 text-right">
                                <form method="post" action="@Url.Action("RemoveRole","Admin")" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="assignmentId" value="@ra.Id"/>
                                    <button type="submit"
                                            onclick="return confirm('Bu rol ataması kaldırılsın mı?')"
                                            class="px-3 py-1 text-xs border border-red-200 dark:border-red-700 text-red-600 dark:text-red-400 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">
                                        Kaldır
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
