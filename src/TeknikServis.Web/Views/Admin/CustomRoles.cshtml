@model IEnumerable<TeknikServis.Domain.Entities.Identity.CustomRole>

<div class="flex flex-col gap-5">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-xl font-semibold text-gray-900 dark:text-white">Özel Roller</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">Firmaya özel roller tanımlayın ve izinlerini ayarlayın</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 rounded-xl px-4 py-3 text-sm text-green-700 dark:text-green-400">
            @TempData["Success"]
        </div>
    }

    @* Yeni Rol Oluştur *@
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-5">
        <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-4">Yeni Özel Rol</h2>
        <form method="post" action="@Url.Action("CreateCustomRole","Admin")">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Rol Adı <span class="text-red-500">*</span></label>
                    <input type="text" name="name" required placeholder="Örn: Kıdemli Teknisyen"
                           class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Açıklama</label>
                    <input type="text" name="description" placeholder="Rol açıklaması..."
                           class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                </div>
            </div>
            <div class="mt-3">
                <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">İzinler (JSON)</label>
                <input type="text" name="permissionsJson" placeholder='["Service.Create","Service.Edit"]'
                       class="w-full px-3 py-2 text-sm font-mono border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                <p class="text-xs text-gray-400 mt-1">Boş bırakılırsa otomatik <code>[]</code> atanır.</p>
            </div>
            <div class="mt-3 flex justify-end">
                <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">Rol Oluştur</button>
            </div>
        </form>
    </div>

    @* Mevcut Roller *@
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
        @if (!Model.Any())
        {
            <div class="text-center py-16 text-gray-400 dark:text-gray-500 text-sm">Özel rol tanımlanmamış</div>
        }
        else
        {
            <table class="w-full text-sm">
                <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                    <tr>
                        <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Rol Adı</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Açıklama</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">İzinler</th>
                        <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Tür</th>
                        <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Durum</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Oluşturulma</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                    @foreach (var role in Model)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                            <td class="px-5 py-3 font-medium text-gray-800 dark:text-gray-200">@role.Name</td>
                            <td class="px-4 py-3 text-gray-500 dark:text-gray-400 text-xs">@(role.Description ?? "—")</td>
                            <td class="px-4 py-3">
                                @{
                                    var perms = System.Text.Json.JsonSerializer.Deserialize<string[]>(role.PermissionsJson) ?? Array.Empty<string>();
                                }
                                @if (perms.Length == 0)
                                {
                                    <span class="text-gray-400 text-xs">—</span>
                                }
                                else
                                {
                                    <span class="text-xs text-gray-600 dark:text-gray-400">@perms.Length izin</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-center">
                                @if (role.IsSystemRole)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 dark:bg-purple-900/40 text-purple-700 dark:text-purple-400">Sistem</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400">Özel</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-center">
                                @if (role.IsActive)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-400">Aktif</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 dark:bg-red-900/40 text-red-700 dark:text-red-400">Pasif</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-xs text-gray-400 dark:text-gray-500">@role.CreatedAt.ToString("dd.MM.yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
