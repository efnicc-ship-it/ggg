@model IEnumerable<TeknikServis.Domain.Entities.Sale.ScrapSaleRecord>

@{
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="flex flex-col gap-5">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-xl font-semibold text-gray-900 dark:text-white">Hurda Satışları</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">Toplam <span class="font-medium">@ViewBag.TotalCount</span> kayıt</p>
        </div>
        <a href="@Url.Action("Index","Sale")" class="text-sm text-blue-600 dark:text-blue-400 hover:underline">← Normal Satışlar</a>
    </div>

    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
        @if (!Model.Any())
        {
            <div class="text-center py-16 text-gray-400 dark:text-gray-500 text-sm">Hurda satış kaydı bulunamadı</div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                        <tr>
                            <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">HRD No</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Alıcı</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Açıklama</th>
                            <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Satış Fiyatı</th>
                            <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Alış Maliyeti</th>
                            <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Kayıp</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Tarih</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                        @foreach (var scrap in Model)
                        {
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                                <td class="px-5 py-3 font-mono text-xs font-medium text-gray-800 dark:text-gray-200">@scrap.RecordNumber</td>
                                <td class="px-4 py-3 text-gray-700 dark:text-gray-300">
                                    @(scrap.BuyerName ?? "—")
                                    @if (!string.IsNullOrEmpty(scrap.BuyerPhone))
                                    {
                                        <div class="text-xs text-gray-400">@scrap.BuyerPhone</div>
                                    }
                                </td>
                                <td class="px-4 py-3 text-gray-600 dark:text-gray-300 max-w-xs truncate">@scrap.Description</td>
                                <td class="px-4 py-3 text-right font-medium text-gray-800 dark:text-gray-200">@scrap.SalePrice.ToString("N2") ₺</td>
                                <td class="px-4 py-3 text-right text-gray-500 dark:text-gray-400">@scrap.OriginalCost.ToString("N2") ₺</td>
                                <td class="px-4 py-3 text-right font-medium text-red-600 dark:text-red-400">-@scrap.LossAmount.ToString("N2") ₺</td>
                                <td class="px-4 py-3 text-xs text-gray-400 dark:text-gray-500">@scrap.CreatedAt.ToString("dd.MM.yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="flex justify-end gap-1 px-4 py-3 border-t border-gray-100 dark:border-gray-700">
                    @for (int p = Math.Max(1, page - 2); p <= Math.Min(totalPages, page + 2); p++)
                    {
                        <a href="@Url.Action("ScrapSales","Sale", new{page=p})"
                           class="px-3 py-1.5 text-sm border rounded-lg @(p == page ? "bg-blue-600 border-blue-600 text-white" : "border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300")">@p</a>
                    }
                </div>
            }
        }
    </div>
</div>
