@model IEnumerable<TeknikServis.Domain.Entities.Sale.SaleRecord>
@using TeknikServis.Domain.Enums

@{
    int page = ViewBag.Page ?? 1;
    int total = ViewBag.TotalCount ?? 0;
    int totalPages = ViewBag.TotalPages ?? 1;
    string? q = ViewBag.Q as string;
}

<div class="flex flex-col gap-5">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-xl font-semibold text-gray-900 dark:text-white">Satış Kayıtları</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">Toplam <span class="font-medium text-gray-700 dark:text-gray-300">@total</span> kayıt</p>
        </div>
        <div class="flex gap-2">
            <a href="@Url.Action("ScrapSales","Sale")"
               class="px-4 py-2 border border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                Hurda Satışları
            </a>
        </div>
    </div>

    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4">
        <form method="get" class="flex gap-3">
            <div class="flex-1 relative">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0"/>
                </svg>
                <input type="text" name="q" value="@q" placeholder="Satış no veya müşteri ara..."
                       class="w-full pl-9 pr-4 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"/>
            </div>
            <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">Ara</button>
        </form>
    </div>

    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
        @if (!Model.Any())
        {
            <div class="text-center py-16 text-gray-400 dark:text-gray-500 text-sm">Kayıt bulunamadı</div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700">
                        <tr>
                            <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Satış No</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Müşteri</th>
                            <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Kalem</th>
                            <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Toplam</th>
                            <th class="text-center px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Ödeme</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Tarih</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                        @foreach (var sale in Model)
                        {
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                                <td class="px-5 py-3 font-mono text-xs font-medium text-gray-800 dark:text-gray-200">@sale.RecordNumber</td>
                                <td class="px-4 py-3 text-gray-700 dark:text-gray-300">
                                    @if (sale.Customer != null)
                                    {
                                        @($"{sale.Customer.FirstName} {sale.Customer.LastName}")
                                    }
                                    else
                                    {
                                        <span class="text-gray-400">Kayıtsız</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-center text-gray-600 dark:text-gray-300">@sale.Items.Count</td>
                                <td class="px-4 py-3 text-right font-medium text-gray-800 dark:text-gray-200">@sale.TotalAmount.ToString("N2") ₺</td>
                                <td class="px-4 py-3 text-center">
                                    @{
                                        var (pbg, ptxt, plabel) = sale.PaymentStatus switch
                                        {
                                            PaymentStatus.Paid => ("bg-green-100 dark:bg-green-900/40", "text-green-700 dark:text-green-400", "Ödendi"),
                                            PaymentStatus.PartiallyPaid => ("bg-amber-100 dark:bg-amber-900/40", "text-amber-700 dark:text-amber-400", "Kısmi"),
                                            PaymentStatus.Deferred => ("bg-blue-100 dark:bg-blue-900/40", "text-blue-700 dark:text-blue-400", "Vadeli"),
                                            _ => ("bg-red-100 dark:bg-red-900/40", "text-red-700 dark:text-red-400", "Ödenmedi")
                                        };
                                    }
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium @pbg @ptxt">@plabel</span>
                                </td>
                                <td class="px-4 py-3 text-xs text-gray-400 dark:text-gray-500">@sale.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="px-4 py-3 text-right">
                                    <a href="@Url.Action("Detail","Sale",new{id=sale.Id})"
                                       class="text-xs text-blue-600 dark:text-blue-400 hover:underline">Detay</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="flex items-center justify-between px-4 py-3 border-t border-gray-100 dark:border-gray-700">
                    <p class="text-sm text-gray-500 dark:text-gray-400">Sayfa @(page) / @totalPages</p>
                    <div class="flex gap-1">
                        @for (int p = Math.Max(1, page - 2); p <= Math.Min(totalPages, page + 2); p++)
                        {
                            <a href="@Url.Action("Index","Sale", new{q, page=p})"
                               class="px-3 py-1.5 text-sm border rounded-lg transition-colors @(p == page ? "bg-blue-600 border-blue-600 text-white" : "border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300")">@p</a>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
